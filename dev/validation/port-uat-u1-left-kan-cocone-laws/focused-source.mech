-- Categories have independent object and morphism Type levels.
-- The equality family and all members specialize together.
poly (u, v) mu MechCategoryCore (0 A : Sort (succ v)) (0 x : A) :
    (0 y : A) -> Prop with
| categoryRefl : MechCategoryCore A x x
where
def Category : (0 Obj : Sort (succ u)) -> Sort (max (succ u) (succ (succ v))) :=
  fun (0 Obj : Sort (succ u)) =>
    (hom : (0 x : Obj) -> (0 y : Obj) -> Sort (succ v)) *
    (identity : (0 x : Obj) -> hom x x) *
    (compose : (0 x : Obj) -> (0 y : Obj) -> (0 z : Obj) ->
      hom x y -> hom y z -> hom x z) *
    (left : (0 x : Obj) -> (0 y : Obj) -> (0 f : hom x y) ->
      MechCategoryCore (hom x y) (compose x x y (identity x) f) f) *
    (right : (0 x : Obj) -> (0 y : Obj) -> (0 f : hom x y) ->
      MechCategoryCore (hom x y) (compose x y y f (identity y)) f) *
    ((0 w : Obj) -> (0 x : Obj) -> (0 y : Obj) -> (0 z : Obj) ->
      (0 f : hom w x) -> (0 g : hom x y) -> (0 h : hom y z) ->
      MechCategoryCore (hom w z)
        (compose w y z (compose w x y f g) h)
        (compose w x z f (compose x y z g h)))

def Hom : (0 Obj : Sort (succ u)) -> (category : Category Obj) ->
    (0 x : Obj) -> (0 y : Obj) -> Sort (succ v) :=
  fun (0 Obj : Sort (succ u)) (category : Category Obj) => category.1

def id : (0 Obj : Sort (succ u)) -> (category : Category Obj) ->
    (0 x : Obj) -> Hom Obj category x x :=
  fun (0 Obj : Sort (succ u)) (category : Category Obj) => category.2.1

def comp : (0 Obj : Sort (succ u)) -> (category : Category Obj) ->
    (0 x : Obj) -> (0 y : Obj) -> (0 z : Obj) ->
    Hom Obj category x y -> Hom Obj category y z -> Hom Obj category x z :=
  fun (0 Obj : Sort (succ u)) (category : Category Obj) => category.2.2.1

def idComp : (0 Obj : Sort (succ u)) -> (category : Category Obj) ->
    (0 x : Obj) -> (0 y : Obj) -> (0 f : Hom Obj category x y) ->
    MechCategoryCore (Hom Obj category x y) (comp Obj category x x y (id Obj category x) f) f :=
  fun (0 Obj : Sort (succ u)) (category : Category Obj) => category.2.2.2.1

def compId : (0 Obj : Sort (succ u)) -> (category : Category Obj) ->
    (0 x : Obj) -> (0 y : Obj) -> (0 f : Hom Obj category x y) ->
    MechCategoryCore (Hom Obj category x y) (comp Obj category x y y f (id Obj category y)) f :=
  fun (0 Obj : Sort (succ u)) (category : Category Obj) => category.2.2.2.2.1

def assoc : (0 Obj : Sort (succ u)) -> (category : Category Obj) ->
    (0 w : Obj) -> (0 x : Obj) -> (0 y : Obj) -> (0 z : Obj) ->
    (0 f : Hom Obj category w x) -> (0 g : Hom Obj category x y) ->
    (0 h : Hom Obj category y z) ->
    MechCategoryCore (Hom Obj category w z)
      (comp Obj category w y z (comp Obj category w x y f g) h)
      (comp Obj category w x z f (comp Obj category x y z g h)) :=
  fun (0 Obj : Sort (succ u)) (category : Category Obj) => category.2.2.2.2.2

-- Equality operations retain this group's nominal equality family.
def eqTrans : (0 A : Sort (succ v)) -> (0 x : A) -> (0 y : A) ->
    (0 z : A) -> MechCategoryCore A x y -> MechCategoryCore A y z -> MechCategoryCore A x z :=
  fun (0 A : Sort (succ v)) (0 x : A) (0 y : A) (0 z : A)
      (first : MechCategoryCore A x y) (second : MechCategoryCore A y z) =>
    match second as self in MechCategoryCore right return MechCategoryCore A x right with
    | categoryRefl => first

def eqCongr : (0 A : Sort (succ v)) -> (0 B : Sort (succ v)) ->
    (0 f : A -> B) -> (0 x : A) -> (0 y : A) ->
    MechCategoryCore A x y -> MechCategoryCore B (f x) (f y) :=
  fun (0 A : Sort (succ v)) (0 B : Sort (succ v)) (0 f : A -> B)
      (0 x : A) (0 y : A) (proof : MechCategoryCore A x y) =>
    match proof as self in MechCategoryCore right return MechCategoryCore B (f x) (f right) with
    | categoryRefl => categoryRefl

end

-- Load category-core.mech before this file.
-- Source and target keep independent universe pairs and equality families.
poly (u, v, w, z) group MechHeterogeneousFunctor where
specialize MechCategoryCore (u, v) as Source
specialize MechCategoryCore (w, z) as Target

def Functor : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    Source_Category C -> Target_Category D -> Sort (max (max (succ u) (succ v)) (max (succ w) (succ z))) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Target_Category D) =>
    (obj : C -> D) *
    (map : (0 x : C) -> (0 y : C) -> Source_Hom C c x y -> Target_Hom D d (obj x) (obj y)) *
    (mapId : (0 x : C) -> Target (Target_Hom D d (obj x) (obj x))
      (map x x (Source_id C c x)) (Target_id D d (obj x))) *
    ((0 x : C) -> (0 y : C) -> (0 z : C) ->
      (0 f : Source_Hom C c x y) -> (0 g : Source_Hom C c y z) ->
      Target (Target_Hom D d (obj x) (obj z))
        (map x z (Source_comp C c x y z f g))
        (Target_comp D d (obj x) (obj y) (obj z) (map x y f) (map y z g)))

def functorObj : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Source_Category C) -> (d : Target_Category D) -> Functor C D c d -> C -> D :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Target_Category D) (F : Functor C D c d) => F.1

def functorMap : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Source_Category C) -> (d : Target_Category D) -> (F : Functor C D c d) ->
    (0 x : C) -> (0 y : C) -> Source_Hom C c x y ->
    Target_Hom D d (functorObj C D c d F x) (functorObj C D c d F y) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Target_Category D) (F : Functor C D c d) => F.2.1


end

-- Load category-core.mech before this file.
-- Three shared categories supply the two inputs and their composite.
poly (u, v, w, z, p, q) group MechComposableFunctors where
specialize MechCategoryCore (u, v) as Source
specialize MechCategoryCore (w, z) as Middle
specialize MechCategoryCore (p, q) as Target

-- First functor over shared category instances.
def First_Functor : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    Source_Category C -> Middle_Category D -> Sort (max (max (succ u) (succ v)) (max (succ w) (succ z))) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Middle_Category D) =>
    (obj : C -> D) *
    (map : (0 x : C) -> (0 y : C) -> Source_Hom C c x y -> Middle_Hom D d (obj x) (obj y)) *
    (mapId : (0 x : C) -> Middle (Middle_Hom D d (obj x) (obj x))
      (map x x (Source_id C c x)) (Middle_id D d (obj x))) *
    ((0 x : C) -> (0 y : C) -> (0 z : C) ->
      (0 f : Source_Hom C c x y) -> (0 g : Source_Hom C c y z) ->
      Middle (Middle_Hom D d (obj x) (obj z))
        (map x z (Source_comp C c x y z f g))
        (Middle_comp D d (obj x) (obj y) (obj z) (map x y f) (map y z g)))

def First_functorObj : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Source_Category C) -> (d : Middle_Category D) -> First_Functor C D c d -> C -> D :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Middle_Category D) (F : First_Functor C D c d) => F.1

def First_functorMap : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Source_Category C) -> (d : Middle_Category D) -> (F : First_Functor C D c d) ->
    (0 x : C) -> (0 y : C) -> Source_Hom C c x y ->
    Middle_Hom D d (First_functorObj C D c d F x) (First_functorObj C D c d F y) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Middle_Category D) (F : First_Functor C D c d) => F.2.1

def First_functorMapId : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Source_Category C) -> (d : Middle_Category D) -> (F : First_Functor C D c d) ->
    (0 x : C) -> Middle (Middle_Hom D d (F.1 x) (F.1 x))
      (First_functorMap C D c d F x x (Source_id C c x)) (Middle_id D d (F.1 x)) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Middle_Category D) (F : First_Functor C D c d) => F.2.2.1

def First_functorMapComp : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Source_Category C) -> (d : Middle_Category D) -> (F : First_Functor C D c d) ->
    (0 x : C) -> (0 y : C) -> (0 z : C) ->
    (0 f : Source_Hom C c x y) -> (0 g : Source_Hom C c y z) ->
    Middle (Middle_Hom D d (F.1 x) (F.1 z))
      (First_functorMap C D c d F x z (Source_comp C c x y z f g))
      (Middle_comp D d (F.1 x) (F.1 y) (F.1 z)
        (First_functorMap C D c d F x y f) (First_functorMap C D c d F y z g)) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Middle_Category D) (F : First_Functor C D c d) => F.2.2.2

-- Congruence crosses both the universe and nominal equality boundary.
def Second_Functor : (0 C : Sort (succ w)) -> (0 D : Sort (succ p)) ->
    Middle_Category C -> Target_Category D -> Sort (max (max (succ w) (succ z)) (max (succ p) (succ q))) :=
  fun (0 C : Sort (succ w)) (0 D : Sort (succ p))
      (c : Middle_Category C) (d : Target_Category D) =>
    (obj : C -> D) *
    (map : (0 x : C) -> (0 y : C) -> Middle_Hom C c x y -> Target_Hom D d (obj x) (obj y)) *
    (mapId : (0 x : C) -> Target (Target_Hom D d (obj x) (obj x))
      (map x x (Middle_id C c x)) (Target_id D d (obj x))) *
    ((0 x : C) -> (0 y : C) -> (0 z : C) ->
      (0 f : Middle_Hom C c x y) -> (0 g : Middle_Hom C c y z) ->
      Target (Target_Hom D d (obj x) (obj z))
        (map x z (Middle_comp C c x y z f g))
        (Target_comp D d (obj x) (obj y) (obj z) (map x y f) (map y z g)))

def Second_functorObj : (0 C : Sort (succ w)) -> (0 D : Sort (succ p)) ->
    (c : Middle_Category C) -> (d : Target_Category D) -> Second_Functor C D c d -> C -> D :=
  fun (0 C : Sort (succ w)) (0 D : Sort (succ p))
      (c : Middle_Category C) (d : Target_Category D) (F : Second_Functor C D c d) => F.1

def Second_functorMap : (0 C : Sort (succ w)) -> (0 D : Sort (succ p)) ->
    (c : Middle_Category C) -> (d : Target_Category D) -> (F : Second_Functor C D c d) ->
    (0 x : C) -> (0 y : C) -> Middle_Hom C c x y ->
    Target_Hom D d (Second_functorObj C D c d F x) (Second_functorObj C D c d F y) :=
  fun (0 C : Sort (succ w)) (0 D : Sort (succ p))
      (c : Middle_Category C) (d : Target_Category D) (F : Second_Functor C D c d) => F.2.1

def Second_functorMapId : (0 C : Sort (succ w)) -> (0 D : Sort (succ p)) ->
    (c : Middle_Category C) -> (d : Target_Category D) -> (F : Second_Functor C D c d) ->
    (0 x : C) -> Target (Target_Hom D d (F.1 x) (F.1 x))
      (Second_functorMap C D c d F x x (Middle_id C c x)) (Target_id D d (F.1 x)) :=
  fun (0 C : Sort (succ w)) (0 D : Sort (succ p))
      (c : Middle_Category C) (d : Target_Category D) (F : Second_Functor C D c d) => F.2.2.1

def Second_functorMapComp : (0 C : Sort (succ w)) -> (0 D : Sort (succ p)) ->
    (c : Middle_Category C) -> (d : Target_Category D) -> (F : Second_Functor C D c d) ->
    (0 x : C) -> (0 y : C) -> (0 z : C) ->
    (0 f : Middle_Hom C c x y) -> (0 g : Middle_Hom C c y z) ->
    Target (Target_Hom D d (F.1 x) (F.1 z))
      (Second_functorMap C D c d F x z (Middle_comp C c x y z f g))
      (Target_comp D d (F.1 x) (F.1 y) (F.1 z)
        (Second_functorMap C D c d F x y f) (Second_functorMap C D c d F y z g)) :=
  fun (0 C : Sort (succ w)) (0 D : Sort (succ p))
      (c : Middle_Category C) (d : Target_Category D) (F : Second_Functor C D c d) => F.2.2.2

-- Congruence crosses both the universe and nominal equality boundary.
def Second_eqCongr : (0 A : Sort (succ z)) -> (0 B : Sort (succ q)) ->
    (0 f : A -> B) -> (0 x : A) -> (0 y : A) ->
    Middle A x y -> Target B (f x) (f y) :=
  fun (0 A : Sort (succ z)) (0 B : Sort (succ q)) (0 f : A -> B)
      (0 x : A) (0 y : A) (proof : Middle A x y) =>
    match proof as self in Middle right return Target B (f x) (f right) with
    | categoryRefl => categoryRefl

-- Composite functor over shared category instances.
def Composite_Functor : (0 C : Sort (succ u)) -> (0 D : Sort (succ p)) ->
    Source_Category C -> Target_Category D -> Sort (max (max (succ u) (succ v)) (max (succ p) (succ q))) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ p))
      (c : Source_Category C) (d : Target_Category D) =>
    (obj : C -> D) *
    (map : (0 x : C) -> (0 y : C) -> Source_Hom C c x y -> Target_Hom D d (obj x) (obj y)) *
    (mapId : (0 x : C) -> Target (Target_Hom D d (obj x) (obj x))
      (map x x (Source_id C c x)) (Target_id D d (obj x))) *
    ((0 x : C) -> (0 y : C) -> (0 z : C) ->
      (0 f : Source_Hom C c x y) -> (0 g : Source_Hom C c y z) ->
      Target (Target_Hom D d (obj x) (obj z))
        (map x z (Source_comp C c x y z f g))
        (Target_comp D d (obj x) (obj y) (obj z) (map x y f) (map y z g)))

def Composite_functorObj : (0 C : Sort (succ u)) -> (0 D : Sort (succ p)) ->
    (c : Source_Category C) -> (d : Target_Category D) -> Composite_Functor C D c d -> C -> D :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ p))
      (c : Source_Category C) (d : Target_Category D) (F : Composite_Functor C D c d) => F.1

def Composite_functorMap : (0 C : Sort (succ u)) -> (0 D : Sort (succ p)) ->
    (c : Source_Category C) -> (d : Target_Category D) -> (F : Composite_Functor C D c d) ->
    (0 x : C) -> (0 y : C) -> Source_Hom C c x y ->
    Target_Hom D d (Composite_functorObj C D c d F x) (Composite_functorObj C D c d F y) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ p))
      (c : Source_Category C) (d : Target_Category D) (F : Composite_Functor C D c d) => F.2.1

def compFunctor : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (0 E : Sort (succ p)) -> (c : Source_Category C) -> (d : Middle_Category D) ->
    (e : Target_Category E) -> First_Functor C D c d -> Second_Functor D E d e -> Composite_Functor C E c e :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w)) (0 E : Sort (succ p))
      (c : Source_Category C) (d : Middle_Category D) (e : Target_Category E)
      (F : First_Functor C D c d) (G : Second_Functor D E d e) =>
    ((fun (x : C) => G.1 (F.1 x)),
     ((fun (0 x : C) (0 y : C) (f : Source_Hom C c x y) =>
         Second_functorMap D E d e G (F.1 x) (F.1 y) (First_functorMap C D c d F x y f)),
      ((fun (0 x : C) =>
          Target_eqTrans (Target_Hom E e (G.1 (F.1 x)) (G.1 (F.1 x)))
            (Second_functorMap D E d e G (F.1 x) (F.1 x)
              (First_functorMap C D c d F x x (Source_id C c x)))
            (Second_functorMap D E d e G (F.1 x) (F.1 x) (Middle_id D d (F.1 x)))
            (Target_id E e (G.1 (F.1 x)))
            (Second_eqCongr (Middle_Hom D d (F.1 x) (F.1 x))
              (Target_Hom E e (G.1 (F.1 x)) (G.1 (F.1 x)))
              (fun (h : Middle_Hom D d (F.1 x) (F.1 x)) =>
                Second_functorMap D E d e G (F.1 x) (F.1 x) h)
              (First_functorMap C D c d F x x (Source_id C c x)) (Middle_id D d (F.1 x))
              (First_functorMapId C D c d F x))
            (Second_functorMapId D E d e G (F.1 x))),
       (fun (0 x : C) (0 y : C) (0 z : C)
            (0 f : Source_Hom C c x y) (0 g : Source_Hom C c y z) =>
          Target_eqTrans (Target_Hom E e (G.1 (F.1 x)) (G.1 (F.1 z)))
            (Second_functorMap D E d e G (F.1 x) (F.1 z)
              (First_functorMap C D c d F x z (Source_comp C c x y z f g)))
            (Second_functorMap D E d e G (F.1 x) (F.1 z)
              (Middle_comp D d (F.1 x) (F.1 y) (F.1 z)
                (First_functorMap C D c d F x y f) (First_functorMap C D c d F y z g)))
            (Target_comp E e (G.1 (F.1 x)) (G.1 (F.1 y)) (G.1 (F.1 z))
              (Second_functorMap D E d e G (F.1 x) (F.1 y) (First_functorMap C D c d F x y f))
              (Second_functorMap D E d e G (F.1 y) (F.1 z) (First_functorMap C D c d F y z g)))
            (Second_eqCongr (Middle_Hom D d (F.1 x) (F.1 z))
              (Target_Hom E e (G.1 (F.1 x)) (G.1 (F.1 z)))
              (fun (h : Middle_Hom D d (F.1 x) (F.1 z)) =>
                Second_functorMap D E d e G (F.1 x) (F.1 z) h)
              (First_functorMap C D c d F x z (Source_comp C c x y z f g))
              (Middle_comp D d (F.1 x) (F.1 y) (F.1 z)
                (First_functorMap C D c d F x y f) (First_functorMap C D c d F y z g))
              (First_functorMapComp C D c d F x y z f g))
            (Second_functorMapComp D E d e G (F.1 x) (F.1 y) (F.1 z)
              (First_functorMap C D c d F x y f) (First_functorMap C D c d F y z g))))))

end

-- Load category-core.mech and heterogeneous-functor.mech first.
-- Both functors share one source and one target category instance.
poly (u, v, w, z) group MechHeterogeneousNatTrans where
specialize MechHeterogeneousFunctor (u, v, w, z) as Base

def targetEqSymm : (0 A : Sort (succ z)) -> (0 x : A) -> (0 y : A) ->
    Base_Target A x y -> Base_Target A y x :=
  fun (0 A : Sort (succ z)) (0 x : A) (0 y : A)
      (proof : Base_Target A x y) =>
    match proof as self in Base_Target right return Base_Target A right x with
    | categoryRefl => categoryRefl

-- Components can inspect their object.  The naturality field erases.
-- A naturality proof can inspect its morphism during proof construction.
def NatTrans : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Base_Source_Category C) -> (d : Base_Target_Category D) ->
    Base_Functor C D c d -> Base_Functor C D c d -> Sort (max (succ u) (succ z)) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Base_Source_Category C) (d : Base_Target_Category D)
      (F : Base_Functor C D c d) (G : Base_Functor C D c d) =>
    (app : (x : C) -> Base_Target_Hom D d (F.1 x) (G.1 x)) *
    ((0 x : C) -> (0 y : C) -> (f : Base_Source_Hom C c x y) ->
      Base_Target (Base_Target_Hom D d (F.1 x) (G.1 y))
        (Base_Target_comp D d (F.1 x) (F.1 y) (G.1 y)
          (Base_functorMap C D c d F x y f) (app y))
        (Base_Target_comp D d (F.1 x) (G.1 x) (G.1 y)
          (app x) (Base_functorMap C D c d G x y f)))

def naturality : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Base_Source_Category C) -> (d : Base_Target_Category D) ->
    (F : Base_Functor C D c d) -> (G : Base_Functor C D c d) ->
    (alpha : NatTrans C D c d F G) ->
    (0 x : C) -> (0 y : C) -> (f : Base_Source_Hom C c x y) ->
    Base_Target (Base_Target_Hom D d (F.1 x) (G.1 y))
      (Base_Target_comp D d (F.1 x) (F.1 y) (G.1 y)
        (Base_functorMap C D c d F x y f) (alpha.1 y))
      (Base_Target_comp D d (F.1 x) (G.1 x) (G.1 y)
        (alpha.1 x) (Base_functorMap C D c d G x y f)) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Base_Source_Category C) (d : Base_Target_Category D)
      (F : Base_Functor C D c d) (G : Base_Functor C D c d)
      (alpha : NatTrans C D c d F G) => alpha.2

def idNat : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Base_Source_Category C) -> (d : Base_Target_Category D) ->
    (F : Base_Functor C D c d) -> NatTrans C D c d F F :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Base_Source_Category C) (d : Base_Target_Category D) (F : Base_Functor C D c d) =>
    ((fun (x : C) => Base_Target_id D d (F.1 x)),
     (fun (0 x : C) (0 y : C) (f : Base_Source_Hom C c x y) =>
       Base_Target_eqTrans (Base_Target_Hom D d (F.1 x) (F.1 y))
       (Base_Target_comp D d (F.1 x) (F.1 y) (F.1 y) (Base_functorMap C D c d F x y f) (Base_Target_id D d (F.1 y)))
       (Base_functorMap C D c d F x y f)
       (Base_Target_comp D d (F.1 x) (F.1 x) (F.1 y) (Base_Target_id D d (F.1 x)) (Base_functorMap C D c d F x y f))
       (Base_Target_compId D d (F.1 x) (F.1 y) (Base_functorMap C D c d F x y f))
       (targetEqSymm (Base_Target_Hom D d (F.1 x) (F.1 y))
       (Base_Target_comp D d (F.1 x) (F.1 x) (F.1 y) (Base_Target_id D d (F.1 x)) (Base_functorMap C D c d F x y f))
       (Base_functorMap C D c d F x y f) (Base_Target_idComp D d (F.1 x) (F.1 y) (Base_functorMap C D c d F x y f)))))

-- Two naturality squares compose using the category laws.
def vcompLaw : (0 D : Sort (succ w)) -> (d : Base_Target_Category D) ->
    (0 fx : D) -> (0 fy : D) -> (0 gx : D) -> (0 gy : D) -> (0 hx : D) -> (0 hy : D) ->
    (0 fm : Base_Target_Hom D d fx fy) -> (0 gm : Base_Target_Hom D d gx gy) -> (0 hm : Base_Target_Hom D d hx hy) ->
    (0 ax : Base_Target_Hom D d fx gx) -> (0 ay : Base_Target_Hom D d fy gy) ->
    (0 bx : Base_Target_Hom D d gx hx) -> (0 by : Base_Target_Hom D d gy hy) ->
    Base_Target (Base_Target_Hom D d fx gy) (Base_Target_comp D d fx fy gy fm ay) (Base_Target_comp D d fx gx gy ax gm) ->
    Base_Target (Base_Target_Hom D d gx hy) (Base_Target_comp D d gx gy hy gm by) (Base_Target_comp D d gx hx hy bx hm) ->
    Base_Target (Base_Target_Hom D d fx hy)
      (Base_Target_comp D d fx fy hy fm (Base_Target_comp D d fy gy hy ay by))
      (Base_Target_comp D d fx hx hy (Base_Target_comp D d fx gx hx ax bx) hm) :=
  fun (0 D : Sort (succ w)) (d : Base_Target_Category D)
      (0 fx : D) (0 fy : D) (0 gx : D) (0 gy : D) (0 hx : D) (0 hy : D)
      (0 fm : Base_Target_Hom D d fx fy) (0 gm : Base_Target_Hom D d gx gy) (0 hm : Base_Target_Hom D d hx hy)
      (0 ax : Base_Target_Hom D d fx gx) (0 ay : Base_Target_Hom D d fy gy)
      (0 bx : Base_Target_Hom D d gx hx) (0 by : Base_Target_Hom D d gy hy)
      (first : Base_Target (Base_Target_Hom D d fx gy)
        (Base_Target_comp D d fx fy gy fm ay) (Base_Target_comp D d fx gx gy ax gm))
      (second : Base_Target (Base_Target_Hom D d gx hy)
        (Base_Target_comp D d gx gy hy gm by) (Base_Target_comp D d gx hx hy bx hm)) =>
    Base_Target_eqTrans (Base_Target_Hom D d fx hy)
      (Base_Target_comp D d fx fy hy fm (Base_Target_comp D d fy gy hy ay by))
      (Base_Target_comp D d fx gy hy (Base_Target_comp D d fx fy gy fm ay) by)
      (Base_Target_comp D d fx hx hy (Base_Target_comp D d fx gx hx ax bx) hm)
      (targetEqSymm (Base_Target_Hom D d fx hy)
        (Base_Target_comp D d fx gy hy (Base_Target_comp D d fx fy gy fm ay) by)
        (Base_Target_comp D d fx fy hy fm (Base_Target_comp D d fy gy hy ay by))
        (Base_Target_assoc D d fx fy gy hy fm ay by))
      (Base_Target_eqTrans (Base_Target_Hom D d fx hy)
        (Base_Target_comp D d fx gy hy (Base_Target_comp D d fx fy gy fm ay) by)
        (Base_Target_comp D d fx gy hy (Base_Target_comp D d fx gx gy ax gm) by)
        (Base_Target_comp D d fx hx hy (Base_Target_comp D d fx gx hx ax bx) hm)
        (Base_Target_eqCongr (Base_Target_Hom D d fx gy) (Base_Target_Hom D d fx hy)
          (fun (h : Base_Target_Hom D d fx gy) => Base_Target_comp D d fx gy hy h by)
          (Base_Target_comp D d fx fy gy fm ay) (Base_Target_comp D d fx gx gy ax gm) first)
        (Base_Target_eqTrans (Base_Target_Hom D d fx hy)
          (Base_Target_comp D d fx gy hy (Base_Target_comp D d fx gx gy ax gm) by)
          (Base_Target_comp D d fx gx hy ax (Base_Target_comp D d gx gy hy gm by))
          (Base_Target_comp D d fx hx hy (Base_Target_comp D d fx gx hx ax bx) hm)
          (Base_Target_assoc D d fx gx gy hy ax gm by)
          (Base_Target_eqTrans (Base_Target_Hom D d fx hy)
            (Base_Target_comp D d fx gx hy ax (Base_Target_comp D d gx gy hy gm by))
            (Base_Target_comp D d fx gx hy ax (Base_Target_comp D d gx hx hy bx hm))
            (Base_Target_comp D d fx hx hy (Base_Target_comp D d fx gx hx ax bx) hm)
            (Base_Target_eqCongr (Base_Target_Hom D d gx hy) (Base_Target_Hom D d fx hy)
              (fun (h : Base_Target_Hom D d gx hy) => Base_Target_comp D d fx gx hy ax h)
              (Base_Target_comp D d gx gy hy gm by) (Base_Target_comp D d gx hx hy bx hm) second)
            (targetEqSymm (Base_Target_Hom D d fx hy)
              (Base_Target_comp D d fx hx hy (Base_Target_comp D d fx gx hx ax bx) hm)
              (Base_Target_comp D d fx gx hy ax (Base_Target_comp D d gx hx hy bx hm))
              (Base_Target_assoc D d fx gx hx hy ax bx hm)))))

-- Vertical composition applies alpha first, then beta.
def vcomp : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Base_Source_Category C) -> (d : Base_Target_Category D) ->
    (F : Base_Functor C D c d) -> (G : Base_Functor C D c d) ->
    (H : Base_Functor C D c d) -> NatTrans C D c d F G ->
    NatTrans C D c d G H -> NatTrans C D c d F H :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Base_Source_Category C) (d : Base_Target_Category D)
      (F : Base_Functor C D c d) (G : Base_Functor C D c d) (H : Base_Functor C D c d)
      (alpha : NatTrans C D c d F G) (beta : NatTrans C D c d G H) =>
    ((fun (x : C) =>
       Base_Target_comp D d (F.1 x) (G.1 x) (H.1 x) (alpha.1 x) (beta.1 x)),
     (fun (0 x : C) (0 y : C) (f : Base_Source_Hom C c x y) =>
       vcompLaw D d (F.1 x) (F.1 y) (G.1 x) (G.1 y) (H.1 x) (H.1 y)
         (Base_functorMap C D c d F x y f) (Base_functorMap C D c d G x y f)
         (Base_functorMap C D c d H x y f) (alpha.1 x) (alpha.1 y) (beta.1 x) (beta.1 y)
         (naturality C D c d F G alpha x y f) (naturality C D c d G H beta x y f)))
end

-- Load category-core.mech and composable-functors.mech first.
-- All three edges share one composable-functor group instance.
poly (u, v, w, z, p, q) group MechHeterogeneousWhiskering where
specialize MechComposableFunctors (u, v, w, z, p, q) as Base

-- Natural transformations on the first edge.
def Second_NatTrans : (0 C : Sort (succ w)) -> (0 D : Sort (succ p)) ->
    (c : Base_Middle_Category C) -> (d : Base_Target_Category D) ->
    Base_Second_Functor C D c d -> Base_Second_Functor C D c d -> Sort (max (succ w) (succ q)) :=
  fun (0 C : Sort (succ w)) (0 D : Sort (succ p))
      (c : Base_Middle_Category C) (d : Base_Target_Category D)
      (F : Base_Second_Functor C D c d) (G : Base_Second_Functor C D c d) =>
    (app : (x : C) -> Base_Target_Hom D d (F.1 x) (G.1 x)) *
    ((0 x : C) -> (0 y : C) -> (f : Base_Middle_Hom C c x y) ->
      Base_Target (Base_Target_Hom D d (F.1 x) (G.1 y))
        (Base_Target_comp D d (F.1 x) (F.1 y) (G.1 y)
          (Base_Second_functorMap C D c d F x y f) (app y))
        (Base_Target_comp D d (F.1 x) (G.1 x) (G.1 y)
          (app x) (Base_Second_functorMap C D c d G x y f)))

def Second_naturality : (0 C : Sort (succ w)) -> (0 D : Sort (succ p)) ->
    (c : Base_Middle_Category C) -> (d : Base_Target_Category D) ->
    (F : Base_Second_Functor C D c d) -> (G : Base_Second_Functor C D c d) ->
    (alpha : Second_NatTrans C D c d F G) ->
    (0 x : C) -> (0 y : C) -> (f : Base_Middle_Hom C c x y) ->
    Base_Target (Base_Target_Hom D d (F.1 x) (G.1 y))
      (Base_Target_comp D d (F.1 x) (F.1 y) (G.1 y)
        (Base_Second_functorMap C D c d F x y f) (alpha.1 y))
      (Base_Target_comp D d (F.1 x) (G.1 x) (G.1 y)
        (alpha.1 x) (Base_Second_functorMap C D c d G x y f)) :=
  fun (0 C : Sort (succ w)) (0 D : Sort (succ p))
      (c : Base_Middle_Category C) (d : Base_Target_Category D)
      (F : Base_Second_Functor C D c d) (G : Base_Second_Functor C D c d)
      (alpha : Second_NatTrans C D c d F G) => alpha.2

-- Natural transformations on the composite edge.
def Composite_NatTrans : (0 C : Sort (succ u)) -> (0 D : Sort (succ p)) ->
    (c : Base_Source_Category C) -> (d : Base_Target_Category D) ->
    Base_Composite_Functor C D c d -> Base_Composite_Functor C D c d -> Sort (max (succ u) (succ q)) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ p))
      (c : Base_Source_Category C) (d : Base_Target_Category D)
      (F : Base_Composite_Functor C D c d) (G : Base_Composite_Functor C D c d) =>
    (app : (x : C) -> Base_Target_Hom D d (F.1 x) (G.1 x)) *
    ((0 x : C) -> (0 y : C) -> (f : Base_Source_Hom C c x y) ->
      Base_Target (Base_Target_Hom D d (F.1 x) (G.1 y))
        (Base_Target_comp D d (F.1 x) (F.1 y) (G.1 y)
          (Base_Composite_functorMap C D c d F x y f) (app y))
        (Base_Target_comp D d (F.1 x) (G.1 x) (G.1 y)
          (app x) (Base_Composite_functorMap C D c d G x y f)))

def whiskerRight : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (0 E : Sort (succ p)) -> (c : Base_Source_Category C) ->
    (d : Base_Middle_Category D) -> (e : Base_Target_Category E) ->
    (F : Base_Second_Functor D E d e) -> (G : Base_Second_Functor D E d e) ->
    Second_NatTrans D E d e F G -> (K : Base_First_Functor C D c d) ->
    Composite_NatTrans C E c e
      (Base_compFunctor C D E c d e K F) (Base_compFunctor C D E c d e K G) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w)) (0 E : Sort (succ p))
      (c : Base_Source_Category C) (d : Base_Middle_Category D) (e : Base_Target_Category E)
      (F : Base_Second_Functor D E d e) (G : Base_Second_Functor D E d e)
      (alpha : Second_NatTrans D E d e F G) (K : Base_First_Functor C D c d) =>
    ((fun (x : C) => alpha.1 (K.1 x)),
     (fun (0 x : C) (0 y : C) (f : Base_Source_Hom C c x y) =>
       Second_naturality D E d e F G alpha (K.1 x) (K.1 y)
         (Base_First_functorMap C D c d K x y f)))

-- Postcomposition maps a first-edge component through H.
-- Its proof crosses the Middle/Target equality boundary by congruence.

end

-- Load category-core, heterogeneous-functor, composable-functors,
-- heterogeneous-nattrans and heterogeneous-whiskering first.
poly (u, v, w, z, p, q) group MechSharedNatTrans where
  specialize MechCategoryCore (u, v) as Source
  specialize MechCategoryCore (w, z) as Middle
  specialize MechCategoryCore (p, q) as Target
  specialize MechHeterogeneousNatTrans (u, v, w, z) as First
    with (Base_Source := Source, Base_Target := Middle)
  specialize MechHeterogeneousNatTrans (w, z, p, q) as Second
    with (Base_Source := Middle, Base_Target := Target)
  specialize MechHeterogeneousNatTrans (u, v, p, q) as Composite
    with (Base_Source := Source, Base_Target := Target)
  specialize MechHeterogeneousWhiskering (u, v, w, z, p, q) as Compose
    with (Base_Source := Source, Base_Middle := Middle, Base_Target := Target)

-- The component is H(alpha x) followed by beta(G x).

end

-- Load category-core, composable-functors and heterogeneous-whiskering first.
-- One shared category triple supplies the functors and natural transformations.
poly (u, v, w, z, p, q) group MechHeterogeneousLeftKan where
specialize MechHeterogeneousWhiskering (u, v, w, z, p, q) as Base

-- Projections retain the independent carrier and field universe levels.
def LanCocone : (0 J : Sort (succ u)) -> (0 C : Sort (succ w)) ->
    (0 D : Sort (succ p)) -> (j : Base_Base_Source_Category J) ->
    (c : Base_Base_Middle_Category C) -> (d : Base_Base_Target_Category D) ->
    Base_Base_First_Functor J C j c -> Base_Base_Composite_Functor J D j d ->
    Base_Base_Second_Functor C D c d -> Sort (max (succ u) (succ q)) :=
  fun (0 J : Sort (succ u)) (0 C : Sort (succ w)) (0 D : Sort (succ p))
      (j : Base_Base_Source_Category J) (c : Base_Base_Middle_Category C)
      (d : Base_Base_Target_Category D) (K : Base_Base_First_Functor J C j c)
      (F : Base_Base_Composite_Functor J D j d) (G : Base_Base_Second_Functor C D c d) =>
    (app : (x : J) -> Base_Base_Target_Hom D d (F.1 x) (G.1 (K.1 x))) *
    ((0 x : J) -> (0 y : J) -> (f : Base_Base_Source_Hom J j x y) ->
      Base_Base_Target (Base_Base_Target_Hom D d (F.1 x) (G.1 (K.1 y)))
        (Base_Base_Target_comp D d (F.1 x) (F.1 y) (G.1 (K.1 y))
          (Base_Base_Composite_functorMap J D j d F x y f) (app y))
        (Base_Base_Target_comp D d (F.1 x) (G.1 (K.1 x)) (G.1 (K.1 y))
          (app x) (Base_Base_Second_functorMap C D c d G (K.1 x) (K.1 y)
            (Base_Base_First_functorMap J C j c K x y f))))

-- The unit followed by a mediator at K's object equals the cocone.

end

-- Load shared-nattrans and heterogeneous-left-kan with their prerequisites.
-- The transformation APIs and the universal property share three families.
poly (u, v, w, z, p, q) group MechSharedLeftKan where
  specialize MechSharedNatTrans (u, v, w, z, p, q) as Base
  specialize MechHeterogeneousLeftKan (u, v, w, z, p, q) as Lan
    with (Base_Base_Source := Base_Source, Base_Base_Middle := Base_Middle,
          Base_Base_Target := Base_Target)

-- View the unit as a transformation in the shared composite API.

end

-- Load shared-left-kan and its prerequisites before this group.
-- These laws compare components, with the shared target equality family.
poly (u, v, w, z, p, q) group MechLeftKanLaws where
  specialize MechSharedLeftKan (u, v, w, z, p, q) as Base

def CoconeEq : (0 J : Sort (succ u)) -> (0 C : Sort (succ w)) ->
    (0 D : Sort (succ p)) -> (j : Base_Base_Source_Category J) ->
    (c : Base_Base_Middle_Category C) -> (d : Base_Base_Target_Category D) ->
    (K : Base_Base_First_Base_Functor J C j c) ->
    (F : Base_Base_Composite_Base_Functor J D j d) ->
    (G : Base_Base_Second_Base_Functor C D c d) ->
    Base_Lan_LanCocone J C D j c d K F G ->
    Base_Lan_LanCocone J C D j c d K F G -> Prop :=
  fun (0 J : Sort (succ u)) (0 C : Sort (succ w)) (0 D : Sort (succ p))
      (j : Base_Base_Source_Category J) (c : Base_Base_Middle_Category C)
      (d : Base_Base_Target_Category D)
      (K : Base_Base_First_Base_Functor J C j c)
      (F : Base_Base_Composite_Base_Functor J D j d)
      (G : Base_Base_Second_Base_Functor C D c d)
      (alpha : Base_Lan_LanCocone J C D j c d K F G)
      (beta : Base_Lan_LanCocone J C D j c d K F G) =>
    (x : J) -> Base_Base_Target (Base_Base_Target_Hom D d (F.1 x) (G.1 (K.1 x)))
      (alpha.1 x) (beta.1 x)

-- Solving the unit cocone gives the identity mediator at every object.
def postCocone : (0 J : Sort (succ u)) -> (0 C : Sort (succ w)) ->
    (0 D : Sort (succ p)) -> (j : Base_Base_Source_Category J) ->
    (c : Base_Base_Middle_Category C) -> (d : Base_Base_Target_Category D) ->
    (K : Base_Base_First_Base_Functor J C j c) ->
    (F : Base_Base_Composite_Base_Functor J D j d) ->
    (G : Base_Base_Second_Base_Functor C D c d) ->
    (I : Base_Base_Second_Base_Functor C D c d) ->
    Base_Lan_LanCocone J C D j c d K F G ->
    Base_Base_Second_NatTrans C D c d G I -> Base_Lan_LanCocone J C D j c d K F I :=
  fun (0 J : Sort (succ u)) (0 C : Sort (succ w)) (0 D : Sort (succ p))
      (j : Base_Base_Source_Category J) (c : Base_Base_Middle_Category C)
      (d : Base_Base_Target_Category D)
      (K : Base_Base_First_Base_Functor J C j c)
      (F : Base_Base_Composite_Base_Functor J D j d)
      (G : Base_Base_Second_Base_Functor C D c d)
      (I : Base_Base_Second_Base_Functor C D c d)
      (alpha : Base_Lan_LanCocone J C D j c d K F G)
      (tau : Base_Base_Second_NatTrans C D c d G I) =>
    Base_Base_Composite_vcomp J D j d F
      (Base_Base_Compose_Base_compFunctor J C D j c d K G)
      (Base_Base_Compose_Base_compFunctor J C D j c d K I) alpha
      (Base_Base_Compose_whiskerRight J C D j c d G I tau K)

-- Postcomposition by the identity preserves every cocone component.
def postCoconeId : (0 J : Sort (succ u)) -> (0 C : Sort (succ w)) ->
    (0 D : Sort (succ p)) -> (j : Base_Base_Source_Category J) ->
    (c : Base_Base_Middle_Category C) -> (d : Base_Base_Target_Category D) ->
    (K : Base_Base_First_Base_Functor J C j c) ->
    (F : Base_Base_Composite_Base_Functor J D j d) ->
    (G : Base_Base_Second_Base_Functor C D c d) ->
    (alpha : Base_Lan_LanCocone J C D j c d K F G) ->
    (x : J) -> Base_Base_Target (Base_Base_Target_Hom D d (F.1 x) (G.1 (K.1 x)))
      (Base_Base_Target_comp D d (F.1 x) (G.1 (K.1 x)) (G.1 (K.1 x))
        (alpha.1 x) (Base_Base_Target_id D d (G.1 (K.1 x)))) (alpha.1 x) :=
  fun (0 J : Sort (succ u)) (0 C : Sort (succ w)) (0 D : Sort (succ p))
      (j : Base_Base_Source_Category J) (c : Base_Base_Middle_Category C)
      (d : Base_Base_Target_Category D)
      (K : Base_Base_First_Base_Functor J C j c)
      (F : Base_Base_Composite_Base_Functor J D j d)
      (G : Base_Base_Second_Base_Functor C D c d)
      (alpha : Base_Lan_LanCocone J C D j c d K F G) (x : J) =>
    Base_Base_Target_compId D d (F.1 x) (G.1 (K.1 x)) (alpha.1 x)

-- Two postcompositions agree with postcomposition by vertical composition.
def postCoconeVcomp : (0 J : Sort (succ u)) -> (0 C : Sort (succ w)) ->
    (0 D : Sort (succ p)) -> (j : Base_Base_Source_Category J) ->
    (c : Base_Base_Middle_Category C) -> (d : Base_Base_Target_Category D) ->
    (K : Base_Base_First_Base_Functor J C j c) ->
    (F : Base_Base_Composite_Base_Functor J D j d) ->
    (G : Base_Base_Second_Base_Functor C D c d) ->
    (I : Base_Base_Second_Base_Functor C D c d) ->
    (H : Base_Base_Second_Base_Functor C D c d) ->
    (alpha : Base_Lan_LanCocone J C D j c d K F G) ->
    (tau : Base_Base_Second_NatTrans C D c d G I) ->
    (sigma : Base_Base_Second_NatTrans C D c d I H) ->
    (x : J) -> Base_Base_Target (Base_Base_Target_Hom D d (F.1 x) (H.1 (K.1 x)))
      (Base_Base_Target_comp D d (F.1 x) (I.1 (K.1 x)) (H.1 (K.1 x))
        (Base_Base_Target_comp D d (F.1 x) (G.1 (K.1 x)) (I.1 (K.1 x))
          (alpha.1 x) (tau.1 (K.1 x))) (sigma.1 (K.1 x)))
      (Base_Base_Target_comp D d (F.1 x) (G.1 (K.1 x)) (H.1 (K.1 x))
        (alpha.1 x) (Base_Base_Target_comp D d (G.1 (K.1 x)) (I.1 (K.1 x)) (H.1 (K.1 x))
          (tau.1 (K.1 x)) (sigma.1 (K.1 x)))) :=
  fun (0 J : Sort (succ u)) (0 C : Sort (succ w)) (0 D : Sort (succ p))
      (j : Base_Base_Source_Category J) (c : Base_Base_Middle_Category C)
      (d : Base_Base_Target_Category D)
      (K : Base_Base_First_Base_Functor J C j c)
      (F : Base_Base_Composite_Base_Functor J D j d)
      (G : Base_Base_Second_Base_Functor C D c d)
      (I : Base_Base_Second_Base_Functor C D c d)
      (H : Base_Base_Second_Base_Functor C D c d)
      (alpha : Base_Lan_LanCocone J C D j c d K F G)
      (tau : Base_Base_Second_NatTrans C D c d G I)
      (sigma : Base_Base_Second_NatTrans C D c d I H) (x : J) =>
    Base_Base_Target_assoc D d (F.1 x) (G.1 (K.1 x))
      (I.1 (K.1 x)) (H.1 (K.1 x)) (alpha.1 x)
      (tau.1 (K.1 x)) (sigma.1 (K.1 x))

-- Postcomposition commutes with choosing the universal mediator.

end

-- Symbolic pins for the left Kan mediator laws at the Wide levels.
-- Each contract binds the solution records itself, so a template whose
-- conclusion is trivial fails to convert against the pinned statement.

specialize MechLeftKanLaws (2, 0, 1, 3, 0, 2) as Wide


def WidePostCoconeIdContract : (0 J : Type 2) -> (0 C : Type 1) -> (0 D : Type 0) ->
    (j : Wide_Base_Base_Source_Category J) -> (c : Wide_Base_Base_Middle_Category C) ->
    (d : Wide_Base_Base_Target_Category D) ->
    (K : Wide_Base_Base_First_Base_Functor J C j c) ->
    (F : Wide_Base_Base_Composite_Base_Functor J D j d) ->
    (G : Wide_Base_Base_Second_Base_Functor C D c d) ->
    (alpha : Wide_Base_Lan_LanCocone J C D j c d K F G) ->
    Wide_CoconeEq J C D j c d K F G
      (Wide_postCocone J C D j c d K F G G alpha (Wide_Base_Base_Second_idNat C D c d G)) alpha :=
  Wide_postCoconeId


def WidePostCoconeVcompContract : (0 J : Type 2) -> (0 C : Type 1) -> (0 D : Type 0) ->
    (j : Wide_Base_Base_Source_Category J) -> (c : Wide_Base_Base_Middle_Category C) ->
    (d : Wide_Base_Base_Target_Category D) ->
    (K : Wide_Base_Base_First_Base_Functor J C j c) ->
    (F : Wide_Base_Base_Composite_Base_Functor J D j d) ->
    (G : Wide_Base_Base_Second_Base_Functor C D c d) ->
    (I : Wide_Base_Base_Second_Base_Functor C D c d) ->
    (H : Wide_Base_Base_Second_Base_Functor C D c d) ->
    (alpha : Wide_Base_Lan_LanCocone J C D j c d K F G) ->
    (tau : Wide_Base_Base_Second_NatTrans C D c d G I) ->
    (sigma : Wide_Base_Base_Second_NatTrans C D c d I H) ->
    Wide_CoconeEq J C D j c d K F H
      (Wide_postCocone J C D j c d K F I H
        (Wide_postCocone J C D j c d K F G I alpha tau) sigma)
      (Wide_postCocone J C D j c d K F G H alpha
        (Wide_Base_Base_Second_vcomp C D c d G I H tau sigma)) :=
  Wide_postCoconeVcomp

-- Source homs have an erased type argument; target homs are pairs of functions.

mu Point : Type 1 with | point : Point

mu Path (0 x : Nat) : (0 y : Nat) -> Prop with | same : Path x x

specialize MechSharedLeftKan (0, 1, 0, 0, 1, 0) as Run

specialize MechHeterogeneousFunctor (0, 1, 0, 0) as ExternalFirst
  with (Source := Run_Base_Source, Target := Run_Base_Middle)

specialize MechHeterogeneousFunctor (0, 0, 1, 0) as ExternalSecond
  with (Source := Run_Base_Middle, Target := Run_Base_Target)

specialize MechHeterogeneousFunctor (0, 1, 1, 0) as ExternalComposite
  with (Source := Run_Base_Source, Target := Run_Base_Target)

specialize MechHeterogeneousNatTrans (0, 0, 1, 0) as ExternalNat
  with (Base_Source := Run_Base_Middle, Base_Target := Run_Base_Target)

def sharedLanInput : Nat := 37


def pathTrans : (0 x : Nat) -> (0 y : Nat) -> (0 z : Nat) ->
    Path x y -> Path y z -> Path x z :=
  fun (0 x : Nat) (0 y : Nat) (0 z : Nat) (f : Path x y) (g : Path y z) =>
    match g as self in Path right return Path x right with | same => f

def IndexedEnd : Run_Base_Source_Category Nat :=
  ((fun (0 x : Nat) (0 y : Nat) => (0 A : Type 0) -> (Path x y) * (Nat -> Nat)),
   ((fun (0 x : Nat) (0 A : Type 0) => (same, (fun (n : Nat) => n))),
    ((fun (0 x : Nat) (0 y : Nat) (0 z : Nat)
          (f : (0 A : Type 0) -> (Path x y) * (Nat -> Nat))
          (g : (0 A : Type 0) -> (Path y z) * (Nat -> Nat)) (0 A : Type 0) =>
        (pathTrans x y z (f A).1 (g A).1, (fun (n : Nat) => (g A).2 ((f A).2 n)))),
     ((fun (0 x : Nat) (0 y : Nat) (0 f : (0 A : Type 0) -> (Path x y) * (Nat -> Nat)) => categoryRefl),
      ((fun (0 x : Nat) (0 y : Nat) (0 f : (0 A : Type 0) -> (Path x y) * (Nat -> Nat)) => categoryRefl),
       (fun (0 w : Nat) (0 x : Nat) (0 y : Nat) (0 z : Nat)
            (0 f : (0 A : Type 0) -> (Path w x) * (Nat -> Nat))
            (0 g : (0 A : Type 0) -> (Path x y) * (Nat -> Nat))
            (0 h : (0 A : Type 0) -> (Path y z) * (Nat -> Nat)) => categoryRefl))))))


def DoubleEnd : Run_Base_Target_Category Point :=
  ((fun (0 x : Point) (0 y : Point) => (Nat -> Nat) * (Nat -> Nat)),
   ((fun (0 x : Point) => ((fun (n : Nat) => n), (fun (n : Nat) => n))),
    ((fun (0 x : Point) (0 y : Point) (0 z : Point)
          (f : (Nat -> Nat) * (Nat -> Nat))
          (g : (Nat -> Nat) * (Nat -> Nat)) =>
       ((fun (n : Nat) => g.1 (f.1 n)), (fun (n : Nat) => g.2 (f.2 n)))),
     ((fun (0 x : Point) (0 y : Point) (0 f : (Nat -> Nat) * (Nat -> Nat)) =>
         categoryRefl),
      ((fun (0 x : Point) (0 y : Point) (0 f : (Nat -> Nat) * (Nat -> Nat)) =>
          categoryRefl),
       (fun (0 w : Point) (0 x : Point) (0 y : Point) (0 z : Point)
            (0 f : (Nat -> Nat) * (Nat -> Nat))
            (0 g : (Nat -> Nat) * (Nat -> Nat))
            (0 h : (Nat -> Nat) * (Nat -> Nat)) => categoryRefl))))))

def IndexedPlain : Run_Base_Middle_Category Nat :=
  ((fun (0 x : Nat) (0 y : Nat) => (Path x y) * (Nat -> Nat)),
   ((fun (0 x : Nat) => (same, (fun (n : Nat) => n))),
    ((fun (0 x : Nat) (0 y : Nat) (0 z : Nat)
          (f : (Path x y) * (Nat -> Nat)) (g : (Path y z) * (Nat -> Nat)) =>
        (pathTrans x y z f.1 g.1, (fun (n : Nat) => g.2 (f.2 n)))),
     ((fun (0 x : Nat) (0 y : Nat) (0 f : (Path x y) * (Nat -> Nat)) => categoryRefl),
      ((fun (0 x : Nat) (0 y : Nat) (0 f : (Path x y) * (Nat -> Nat)) => categoryRefl),
       (fun (0 w : Nat) (0 x : Nat) (0 y : Nat) (0 z : Nat)
            (0 f : (Path w x) * (Nat -> Nat))
            (0 g : (Path x y) * (Nat -> Nat))
            (0 h : (Path y z) * (Nat -> Nat)) => categoryRefl))))))


def Constant : ExternalSecond_Functor Nat Point IndexedPlain DoubleEnd :=
  ((fun (x : Nat) => point),
   ((fun (0 x : Nat) (0 y : Nat) (f : (Path x y) * (Nat -> Nat)) =>
       ((fun (n : Nat) => n), (fun (n : Nat) => n))),
    ((fun (0 x : Nat) => categoryRefl),
     (fun (0 x : Nat) (0 y : Nat) (0 z : Nat)
          (0 f : (Path x y) * (Nat -> Nat)) (0 g : (Path y z) * (Nat -> Nat)) => categoryRefl))))

def Components : (x : Nat) -> (Nat -> Nat) * (Nat -> Nat) :=
  fun (x : Nat) => ((fun (n : Nat) => x), (fun (n : Nat) => natAdd n x))

def componentLaw : (0 x : Nat) -> (0 y : Nat) -> Path x y ->
    Run_Base_Target ((Nat -> Nat) * (Nat -> Nat)) (Components y) (Components x) :=
  fun (0 x : Nat) (0 y : Nat) (proof : Path x y) =>
    match proof as self in Path right return
      Run_Base_Target ((Nat -> Nat) * (Nat -> Nat)) (Components right) (Components x) with
    | same => categoryRefl

def Alpha : ExternalNat_NatTrans Nat Point IndexedPlain DoubleEnd Constant Constant :=
  (Components,
   (fun (0 x : Nat) (0 y : Nat) (f : (Path x y) * (Nat -> Nat)) =>
     componentLaw x y f.1))

-- Forget the erased type argument. Every middle arrow has a source lift.

def Forget : ExternalFirst_Functor Nat Nat IndexedEnd IndexedPlain :=
  ((fun (x : Nat) => x),
   ((fun (0 x : Nat) (0 y : Nat) (f : (0 A : Type 0) -> (Path x y) * (Nat -> Nat)) =>
       (f Nat)),
    ((fun (0 x : Nat) => categoryRefl),
     (fun (0 x : Nat) (0 y : Nat) (0 z : Nat)
          (0 f : (0 A : Type 0) -> (Path x y) * (Nat -> Nat))
          (0 g : (0 A : Type 0) -> (Path y z) * (Nat -> Nat)) => categoryRefl))))

def OtherComponents : (x : Nat) -> (Nat -> Nat) * (Nat -> Nat) :=
  fun (x : Nat) => ((fun (n : Nat) => natAdd x 11), (fun (n : Nat) => natAdd (natAdd n x) 4))

def otherComponentLaw : (0 x : Nat) -> (0 y : Nat) -> Path x y ->
    Run_Base_Target ((Nat -> Nat) * (Nat -> Nat)) (OtherComponents y) (OtherComponents x) :=
  fun (0 x : Nat) (0 y : Nat) (proof : Path x y) =>
    match proof as self in Path right return
      Run_Base_Target ((Nat -> Nat) * (Nat -> Nat)) (OtherComponents right) (OtherComponents x) with
    | same => categoryRefl

def Beta : ExternalNat_NatTrans Nat Point IndexedPlain DoubleEnd Constant Constant :=
  (OtherComponents,
   (fun (0 x : Nat) (0 y : Nat) (f : (Path x y) * (Nat -> Nat)) => otherComponentLaw x y f.1))

-- The candidate works for every target functor, with the cocone supplied to its solver.

def Original : ExternalComposite_Functor Nat Point IndexedEnd DoubleEnd :=
  Run_Base_Compose_Base_compFunctor Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Constant

def Cocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Run_Base_Compose_whiskerRight Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Constant Constant Alpha Forget

-- Reuse the indexed categories, cocones and solvers of shared-left-kan-runtime.

specialize MechLeftKanLaws (0, 1, 0, 0, 1, 0) as Laws
  with (Base_Base_Source := Run_Base_Source, Base_Base_Middle := Run_Base_Middle,
        Base_Base_Target := Run_Base_Target)

specialize MechCategoryCore (1, 0) as SeparateTarget


def lanCertified : (left : (Nat -> Nat) * (Nat -> Nat)) ->
    (0 right : (Nat -> Nat) * (Nat -> Nat)) ->
    (0 proof : Run_Base_Target ((Nat -> Nat) * (Nat -> Nat)) left right) -> Nat -> Nat :=
  fun (left : (Nat -> Nat) * (Nat -> Nat)) (0 right : (Nat -> Nat) * (Nat -> Nat))
      (0 proof : Run_Base_Target ((Nat -> Nat) * (Nat -> Nat)) left right) (n : Nat) =>
    natAdd (natMul 101 (left.1 (natAdd n 7))) (left.2 (natAdd n 11))

def IdentityPostCocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Cocone (Run_Base_Second_idNat Nat Point IndexedPlain DoubleEnd Constant)

def NestedPostCocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant Constant
    (Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
      Constant Constant Cocone Alpha) Beta

def CompositePostCocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant Constant Cocone
    (Run_Base_Second_vcomp Nat Point IndexedPlain DoubleEnd Constant Constant Constant Alpha Beta)

def ReverseNestedPostCocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant Constant
    (Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
      Constant Constant Cocone Beta) Alpha

def ReverseCompositePostCocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant Constant Cocone
    (Run_Base_Second_vcomp Nat Point IndexedPlain DoubleEnd Constant Constant Constant Beta Alpha)

def postIdentityLaw : Laws_CoconeEq Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant IdentityPostCocone Cocone :=
  Laws_postCoconeId Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant Cocone

def postVcompLaw : Laws_CoconeEq Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant NestedPostCocone CompositePostCocone :=
  Laws_postCoconeVcomp Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Constant Cocone Alpha Beta

def postReverseVcompLaw : Laws_CoconeEq Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant ReverseNestedPostCocone ReverseCompositePostCocone :=
  Laws_postCoconeVcomp Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Constant Cocone Beta Alpha

def lanPostIdentityAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (IdentityPostCocone.1 x) (Cocone.1 x) (postIdentityLaw x) x

def lanPostIdentityReferenceAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (Cocone.1 x) (Cocone.1 x) categoryRefl x

def lanPostVcompAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (NestedPostCocone.1 x) (CompositePostCocone.1 x) (postVcompLaw x) x

def lanPostVcompReferenceAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (CompositePostCocone.1 x) (CompositePostCocone.1 x) categoryRefl x

def lanPostReverseVcompAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (ReverseNestedPostCocone.1 x) (ReverseCompositePostCocone.1 x) (postReverseVcompLaw x) x

def lanPostReverseVcompReferenceAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (ReverseCompositePostCocone.1 x) (ReverseCompositePostCocone.1 x) categoryRefl x

def lanPostIdentity : Nat := lanPostIdentityAt sharedLanInput

def lanPostIdentityReference : Nat := lanPostIdentityReferenceAt sharedLanInput

def lanPostVcomp : Nat := lanPostVcompAt sharedLanInput

def lanPostVcompReference : Nat := lanPostVcompReferenceAt sharedLanInput

def lanPostReverseVcomp : Nat := lanPostReverseVcompAt sharedLanInput

def lanPostReverseVcompReference : Nat := lanPostReverseVcompReferenceAt sharedLanInput
