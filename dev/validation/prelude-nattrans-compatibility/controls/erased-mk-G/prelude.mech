-- Source adapters keep QMany binders inside motive types and the imported universe order; top-level binders are erased.
poly (u) mu MechSignatureEq (0 A : Sort u) (0 x : A) : (0 y : A) -> Prop with
| signatureReflCtor : MechSignatureEq A x x
where
def refl : (0 A : Sort u) -> (0 x : A) -> MechSignatureEq A x x :=
  fun (0 A : Sort u) (0 x : A) => signatureReflCtor
def symm : (0 A : Sort u) -> (0 x : A) -> (0 y : A) ->
    MechSignatureEq A x y -> MechSignatureEq A y x :=
  fun (0 A : Sort u) (0 x : A) (0 y : A) (e : MechSignatureEq A x y) =>
    case e as self in MechSignatureEq right return MechSignatureEq A right x with
    | signatureReflCtor => refl A x
def trans : (0 A : Sort u) -> (0 x : A) -> (0 y : A) -> (0 z : A) ->
    MechSignatureEq A x y -> MechSignatureEq A y z -> MechSignatureEq A x z :=
  fun (0 A : Sort u) (0 x : A) (0 y : A) (0 z : A)
    (first : MechSignatureEq A x y) (second : MechSignatureEq A y z) =>
      case second as self in MechSignatureEq right return MechSignatureEq A x right with
      | signatureReflCtor => first
end

poly (v, u) group MechSignatureElimination where
specialize MechSignatureEq (u) as Carrier
def ndrec : (0 A : Sort u) -> (0 x : A) -> (0 P : A -> Sort v) ->
    P x -> (0 y : A) -> Carrier A x y -> P y :=
  fun (0 A : Sort u) (0 x : A) (0 P : A -> Sort v)
    (base : P x) (0 y : A) (e : Carrier A x y) =>
      case e as self in Carrier right return P right with
      | signatureReflCtor => base
def dependentRec : (0 A : Sort u) -> (0 x : A) ->
    (0 P : (y : A) -> Carrier A x y -> Sort v) ->
    P x (Carrier_refl A x) -> (0 y : A) -> (e : Carrier A x y) -> P y e :=
  fun (0 A : Sort u) (0 x : A)
    (0 P : (y : A) -> Carrier A x y -> Sort v)
    (base : P x (Carrier_refl A x)) (0 y : A) (e : Carrier A x y) =>
      case e as self in Carrier right return P right self with
      | signatureReflCtor => base
end

poly (u, v) group MechSignatureCongruence where
specialize MechSignatureEq (u) as Source
specialize MechSignatureEq (v) as Target
def congrArg : (0 A : Sort u) -> (0 B : Sort v) -> (0 x : A) -> (0 y : A) ->
    (f : A -> B) -> Source A x y -> Target B (f x) (f y) :=
  fun (0 A : Sort u) (0 B : Sort v) (0 x : A) (0 y : A)
    (f : A -> B) (e : Source A x y) =>
      case e as self in Source right return Target B (f x) (f right) with
      | signatureReflCtor => Target_refl B (f x)
end

-- The export keeps relevant object binders inside stored fields.
-- Constructor fields retain the source order: comp_id precedes id_comp.
poly (u, v) group MechSignatureCategory where
specialize MechSignatureEq ((succ v)) as Eq

def Category : (0 Obj : Sort (succ u)) -> Sort (max (succ u) (succ (succ v))) :=
  fun (0 Obj : Sort (succ u)) =>
    (hom : (x : Obj) -> (y : Obj) -> Sort (succ v)) *
    (identity : (x : Obj) -> hom x x) *
    (compose : (x : Obj) -> (y : Obj) -> (z : Obj) ->
      hom x y -> hom y z -> hom x z) *
    (right : (x : Obj) -> (y : Obj) -> (f : hom x y) ->
      Eq (hom x y) (compose x y y f (identity y)) f) *
    (left : (x : Obj) -> (y : Obj) -> (f : hom x y) ->
      Eq (hom x y) (compose x x y (identity x) f) f) *
    ((w : Obj) -> (x : Obj) -> (y : Obj) -> (z : Obj) ->
      (f : hom w x) -> (g : hom x y) -> (h : hom y z) ->
      Eq (hom w z) (compose w y z (compose w x y f g) h)
        (compose w x z f (compose x y z g h)))

def mk : (0 Obj : Sort (succ u)) ->
    (hom : (x : Obj) -> (y : Obj) -> Sort (succ v)) ->
    (identity : (x : Obj) -> hom x x) ->
    (compose : (x : Obj) -> (y : Obj) -> (z : Obj) ->
      hom x y -> hom y z -> hom x z) ->
    (right : (x : Obj) -> (y : Obj) -> (f : hom x y) ->
      Eq (hom x y) (compose x y y f (identity y)) f) ->
    (left : (x : Obj) -> (y : Obj) -> (f : hom x y) ->
      Eq (hom x y) (compose x x y (identity x) f) f) ->
    (associativity : (w : Obj) -> (x : Obj) -> (y : Obj) -> (z : Obj) ->
      (f : hom w x) -> (g : hom x y) -> (h : hom y z) ->
      Eq (hom w z) (compose w y z (compose w x y f g) h)
        (compose w x z f (compose x y z g h))) -> Category Obj :=
  fun (0 Obj : Sort (succ u))
      (hom : (x : Obj) -> (y : Obj) -> Sort (succ v))
      (identity : (x : Obj) -> hom x x)
      (compose : (x : Obj) -> (y : Obj) -> (z : Obj) ->
        hom x y -> hom y z -> hom x z)
      (right : (x : Obj) -> (y : Obj) -> (f : hom x y) ->
        Eq (hom x y) (compose x y y f (identity y)) f)
      (left : (x : Obj) -> (y : Obj) -> (f : hom x y) ->
        Eq (hom x y) (compose x x y (identity x) f) f)
      (associativity : (w : Obj) -> (x : Obj) -> (y : Obj) -> (z : Obj) ->
        (f : hom w x) -> (g : hom x y) -> (h : hom y z) ->
        Eq (hom w z) (compose w y z (compose w x y f g) h)
          (compose w x z f (compose x y z g h))) =>
    (hom, (identity, (compose, (right, (left, associativity)))))

def Hom : (0 Obj : Sort (succ u)) -> (category : Category Obj) ->
    (x : Obj) -> (y : Obj) -> Sort (succ v) :=
  fun (0 Obj : Sort (succ u)) (category : Category Obj) => category.1

def id : (0 Obj : Sort (succ u)) -> (category : Category Obj) ->
    (x : Obj) -> Hom Obj category x x :=
  fun (0 Obj : Sort (succ u)) (category : Category Obj) => category.2.1

def comp : (0 Obj : Sort (succ u)) -> (category : Category Obj) ->
    (x : Obj) -> (y : Obj) -> (z : Obj) ->
    Hom Obj category x y -> Hom Obj category y z -> Hom Obj category x z :=
  fun (0 Obj : Sort (succ u)) (category : Category Obj) => category.2.2.1

def comp_id : (0 Obj : Sort (succ u)) -> (category : Category Obj) ->
    (x : Obj) -> (y : Obj) -> (f : Hom Obj category x y) ->
    Eq (Hom Obj category x y)
      (comp Obj category x y y f (id Obj category y)) f :=
  fun (0 Obj : Sort (succ u)) (category : Category Obj) => category.2.2.2.1

def id_comp : (0 Obj : Sort (succ u)) -> (category : Category Obj) ->
    (x : Obj) -> (y : Obj) -> (f : Hom Obj category x y) ->
    Eq (Hom Obj category x y)
      (comp Obj category x x y (id Obj category x) f) f :=
  fun (0 Obj : Sort (succ u)) (category : Category Obj) => category.2.2.2.2.1

def assoc : (0 Obj : Sort (succ u)) -> (category : Category Obj) ->
    (w : Obj) -> (x : Obj) -> (y : Obj) -> (z : Obj) ->
    (f : Hom Obj category w x) -> (g : Hom Obj category x y) ->
    (h : Hom Obj category y z) ->
    Eq (Hom Obj category w z)
      (comp Obj category w y z (comp Obj category w x y f g) h)
      (comp Obj category w x z f (comp Obj category x y z g h)) :=
  fun (0 Obj : Sort (succ u)) (category : Category Obj) => category.2.2.2.2.2
end

-- Preserve the imported Functor's relevant arguments and stored field order.
poly (u, v, w, z) group MechSignatureFunctor where
specialize MechSignatureCategory (u, v) as Source
specialize MechSignatureCategory (w, z) as Target

def Functor : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    Source_Category C -> Target_Category D ->
    Sort (max (max (max (succ u) (succ w)) (succ v)) (succ z)) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Target_Category D) =>
    (objects : C -> D) *
    (morphisms : (x : C) -> (y : C) -> Source_Hom C c x y ->
      Target_Hom D d (objects x) (objects y)) *
    (identities : (x : C) -> Target_Eq (Target_Hom D d (objects x) (objects x))
      (morphisms x x (Source_id C c x)) (Target_id D d (objects x))) *
    ((x : C) -> (y : C) -> (a : C) ->
      (f : Source_Hom C c x y) -> (g : Source_Hom C c y a) ->
      Target_Eq (Target_Hom D d (objects x) (objects a))
        (morphisms x a (Source_comp C c x y a f g))
        (Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g)))

def mk : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Source_Category C) -> (d : Target_Category D) ->
    (objects : C -> D) ->
    (morphisms : (x : C) -> (y : C) -> Source_Hom C c x y ->
      Target_Hom D d (objects x) (objects y)) ->
    (identities : (x : C) -> Target_Eq (Target_Hom D d (objects x) (objects x))
      (morphisms x x (Source_id C c x)) (Target_id D d (objects x))) ->
    (composition : (x : C) -> (y : C) -> (a : C) ->
      (f : Source_Hom C c x y) -> (g : Source_Hom C c y a) ->
      Target_Eq (Target_Hom D d (objects x) (objects a))
        (morphisms x a (Source_comp C c x y a f g))
        (Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g))) -> Functor C D c d :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Target_Category D)
      (objects : C -> D)
      (morphisms : (x : C) -> (y : C) -> Source_Hom C c x y ->
        Target_Hom D d (objects x) (objects y))
      (identities : (x : C) -> Target_Eq (Target_Hom D d (objects x) (objects x))
        (morphisms x x (Source_id C c x)) (Target_id D d (objects x)))
      (composition : (x : C) -> (y : C) -> (a : C) ->
        (f : Source_Hom C c x y) -> (g : Source_Hom C c y a) ->
        Target_Eq (Target_Hom D d (objects x) (objects a))
          (morphisms x a (Source_comp C c x y a f g))
          (Target_comp D d (objects x) (objects y) (objects a)
            (morphisms x y f) (morphisms y a g))) =>
    (objects, (morphisms, (identities, composition)))

def obj : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Source_Category C) -> (d : Target_Category D) -> Functor C D c d -> C -> D :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Target_Category D) (F : Functor C D c d) => F.1

def map : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Source_Category C) -> (d : Target_Category D) -> (F : Functor C D c d) ->
    (x : C) -> (y : C) -> Source_Hom C c x y ->
    Target_Hom D d (obj C D c d F x) (obj C D c d F y) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Target_Category D) (F : Functor C D c d) => F.2.1

def map_id : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Source_Category C) -> (d : Target_Category D) -> (F : Functor C D c d) ->
    (x : C) -> Target_Eq (Target_Hom D d (obj C D c d F x) (obj C D c d F x))
      (map C D c d F x x (Source_id C c x)) (Target_id D d (obj C D c d F x)) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Target_Category D) (F : Functor C D c d) => F.2.2.1

def map_comp : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Source_Category C) -> (d : Target_Category D) -> (F : Functor C D c d) ->
    (x : C) -> (y : C) -> (a : C) ->
    (f : Source_Hom C c x y) -> (g : Source_Hom C c y a) ->
    Target_Eq (Target_Hom D d (obj C D c d F x) (obj C D c d F a))
      (map C D c d F x a (Source_comp C c x y a f g))
      (Target_comp D d (obj C D c d F x) (obj C D c d F y) (obj C D c d F a)
        (map C D c d F x y f) (map C D c d F y a g)) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Source_Category C) (d : Target_Category D) (F : Functor C D c d) => F.2.2.2
end

-- Source-compatible natural transformations with relevant nested object arguments.
poly (u, v, w, z) group MechSignatureNatTrans where
specialize MechSignatureFunctor (u, v, w, z) as Base

def NatTrans : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Base_Source_Category C) -> (d : Base_Target_Category D) ->
    (F : Base_Functor C D c d) -> (G : Base_Functor C D c d) ->
    Sort (max (succ u) (succ z)) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Base_Source_Category C) (d : Base_Target_Category D)
      (F : Base_Functor C D c d) (G : Base_Functor C D c d) =>
    (components : (x : C) -> Base_Target_Hom D d
      (Base_obj C D c d F x) (Base_obj C D c d G x)) *
    ((x : C) -> (y : C) -> (f : Base_Source_Hom C c x y) ->
      Base_Target_Eq (Base_Target_Hom D d
        (Base_obj C D c d F x) (Base_obj C D c d G y))
      (Base_Target_comp D d
        (Base_obj C D c d F x) (Base_obj C D c d F y) (Base_obj C D c d G y)
        (Base_map C D c d F x y f) (components y))
      (Base_Target_comp D d
        (Base_obj C D c d F x) (Base_obj C D c d G x) (Base_obj C D c d G y)
        (components x) (Base_map C D c d G x y f)))

def mk : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Base_Source_Category C) -> (d : Base_Target_Category D) ->
    (F : Base_Functor C D c d) -> (0 G : Base_Functor C D c d) ->
    (components : (x : C) -> Base_Target_Hom D d
      (Base_obj C D c d F x) (Base_obj C D c d G x)) ->
    ((x : C) -> (y : C) -> (f : Base_Source_Hom C c x y) ->
      Base_Target_Eq (Base_Target_Hom D d
        (Base_obj C D c d F x) (Base_obj C D c d G y))
      (Base_Target_comp D d
        (Base_obj C D c d F x) (Base_obj C D c d F y) (Base_obj C D c d G y)
        (Base_map C D c d F x y f) (components y))
      (Base_Target_comp D d
        (Base_obj C D c d F x) (Base_obj C D c d G x) (Base_obj C D c d G y)
        (components x) (Base_map C D c d G x y f))) -> NatTrans C D c d F G :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Base_Source_Category C) (d : Base_Target_Category D)
      (F : Base_Functor C D c d) (0 G : Base_Functor C D c d)
      (components : (x : C) -> Base_Target_Hom D d
        (Base_obj C D c d F x) (Base_obj C D c d G x))
      (naturality : (x : C) -> (y : C) -> (f : Base_Source_Hom C c x y) ->
        Base_Target_Eq (Base_Target_Hom D d
          (Base_obj C D c d F x) (Base_obj C D c d G y))
        (Base_Target_comp D d
          (Base_obj C D c d F x) (Base_obj C D c d F y) (Base_obj C D c d G y)
          (Base_map C D c d F x y f) (components y))
        (Base_Target_comp D d
          (Base_obj C D c d F x) (Base_obj C D c d G x) (Base_obj C D c d G y)
          (components x) (Base_map C D c d G x y f))) =>
    (components, naturality)

def app : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Base_Source_Category C) -> (d : Base_Target_Category D) ->
    (F : Base_Functor C D c d) -> (G : Base_Functor C D c d) ->
    NatTrans C D c d F G -> (x : C) -> Base_Target_Hom D d
      (Base_obj C D c d F x) (Base_obj C D c d G x) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Base_Source_Category C) (d : Base_Target_Category D)
      (F : Base_Functor C D c d) (G : Base_Functor C D c d)
      (alpha : NatTrans C D c d F G) => alpha.1

def naturality : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : Base_Source_Category C) -> (d : Base_Target_Category D) ->
    (F : Base_Functor C D c d) -> (G : Base_Functor C D c d) ->
    (alpha : NatTrans C D c d F G) ->
    (x : C) -> (y : C) -> (f : Base_Source_Hom C c x y) ->
    Base_Target_Eq (Base_Target_Hom D d
      (Base_obj C D c d F x) (Base_obj C D c d G y))
    (Base_Target_comp D d
      (Base_obj C D c d F x) (Base_obj C D c d F y) (Base_obj C D c d G y)
      (Base_map C D c d F x y f) (app C D c d F G alpha y))
    (Base_Target_comp D d
      (Base_obj C D c d F x) (Base_obj C D c d G x) (Base_obj C D c d G y)
      (app C D c d F G alpha x) (Base_map C D c d G x y f)) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : Base_Source_Category C) (d : Base_Target_Category D)
      (F : Base_Functor C D c d) (G : Base_Functor C D c d)
      (alpha : NatTrans C D c d F G) => alpha.2
end
