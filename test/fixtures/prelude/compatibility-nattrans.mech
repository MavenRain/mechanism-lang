-- Arbitrary components and squares pin both projections and the stored shape.
-- A sort pin fixes the source hom level, which the signatures do not show.
poly (u, v, w, z) group CompatibilityNatTransComputations where
specialize MechSignatureNatTrans (u, v, w, z) as N
specialize MechSignatureEq (0) as Proofs

def Components : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : N_Base_Source_Category C) -> (d : N_Base_Target_Category D) ->
    N_Base_Functor C D c d -> N_Base_Functor C D c d ->
    Sort (max (succ u) (succ z)) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : N_Base_Source_Category C) (d : N_Base_Target_Category D)
      (F : N_Base_Functor C D c d) (G : N_Base_Functor C D c d) =>
    (x : C) -> N_Base_Target_Hom D d
      (N_Base_obj C D c d F x) (N_Base_obj C D c d G x)

def Square : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : N_Base_Source_Category C) -> (d : N_Base_Target_Category D) ->
    (F : N_Base_Functor C D c d) -> (G : N_Base_Functor C D c d) ->
    Components C D c d F G -> Prop :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : N_Base_Source_Category C) (d : N_Base_Target_Category D)
      (F : N_Base_Functor C D c d) (G : N_Base_Functor C D c d)
      (components : Components C D c d F G) =>
    (x : C) -> (y : C) -> (f : N_Base_Source_Hom C c x y) ->
      N_Base_Target_Eq (N_Base_Target_Hom D d
        (N_Base_obj C D c d F x) (N_Base_obj C D c d G y))
      (N_Base_Target_comp D d
        (N_Base_obj C D c d F x) (N_Base_obj C D c d F y) (N_Base_obj C D c d G y)
        (N_Base_map C D c d F x y f) (components y))
      (N_Base_Target_comp D d
        (N_Base_obj C D c d F x) (N_Base_obj C D c d G x) (N_Base_obj C D c d G y)
        (components x) (N_Base_map C D c d G x y f))

def componentProjection : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : N_Base_Source_Category C) -> (d : N_Base_Target_Category D) ->
    (F : N_Base_Functor C D c d) -> (G : N_Base_Functor C D c d) ->
    (components : Components C D c d F G) -> (square : Square C D c d F G components) ->
    (x : C) -> N_Base_Target_Eq
      (N_Base_Target_Hom D d (N_Base_obj C D c d F x) (N_Base_obj C D c d G x))
      (N_app C D c d F G (N_mk C D c d F G components square) x) (components x) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : N_Base_Source_Category C) (d : N_Base_Target_Category D)
      (F : N_Base_Functor C D c d) (G : N_Base_Functor C D c d)
      (components : Components C D c d F G) (square : Square C D c d F G components)
      (x : C) => N_Base_Target_Eq_refl
        (N_Base_Target_Hom D d (N_Base_obj C D c d F x) (N_Base_obj C D c d G x))
        (components x)

def naturalityProjection : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : N_Base_Source_Category C) -> (d : N_Base_Target_Category D) ->
    (F : N_Base_Functor C D c d) -> (G : N_Base_Functor C D c d) ->
    (components : Components C D c d F G) -> (square : Square C D c d F G components) ->
    (x : C) -> (y : C) -> (f : N_Base_Source_Hom C c x y) ->
    Proofs (N_Base_Target_Eq
      (N_Base_Target_Hom D d (N_Base_obj C D c d F x) (N_Base_obj C D c d G y))
      (N_Base_Target_comp D d
        (N_Base_obj C D c d F x) (N_Base_obj C D c d F y) (N_Base_obj C D c d G y)
        (N_Base_map C D c d F x y f) (components y))
      (N_Base_Target_comp D d
        (N_Base_obj C D c d F x) (N_Base_obj C D c d G x) (N_Base_obj C D c d G y)
        (components x) (N_Base_map C D c d G x y f)))
      (N_naturality C D c d F G (N_mk C D c d F G components square) x y f)
      (square x y f) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : N_Base_Source_Category C) (d : N_Base_Target_Category D)
      (F : N_Base_Functor C D c d) (G : N_Base_Functor C D c d)
      (components : Components C D c d F G) (square : Square C D c d F G components)
      (x : C) (y : C) (f : N_Base_Source_Hom C c x y) =>
    Proofs_refl (N_Base_Target_Eq
      (N_Base_Target_Hom D d (N_Base_obj C D c d F x) (N_Base_obj C D c d G y))
      (N_Base_Target_comp D d
        (N_Base_obj C D c d F x) (N_Base_obj C D c d F y) (N_Base_obj C D c d G y)
        (N_Base_map C D c d F x y f) (components y))
      (N_Base_Target_comp D d
        (N_Base_obj C D c d F x) (N_Base_obj C D c d G x) (N_Base_obj C D c d G y)
        (components x) (N_Base_map C D c d G x y f))) (square x y f)

def storedShape : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : N_Base_Source_Category C) -> (d : N_Base_Target_Category D) ->
    (F : N_Base_Functor C D c d) -> (G : N_Base_Functor C D c d) ->
    ((components : Components C D c d F G) * Square C D c d F G components) ->
    N_NatTrans C D c d F G :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : N_Base_Source_Category C) (d : N_Base_Target_Category D)
      (F : N_Base_Functor C D c d) (G : N_Base_Functor C D c d)
      (record : (components : Components C D c d F G) * Square C D c d F G components) => record

def typeQuantities : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : N_Base_Source_Category C) -> (d : N_Base_Target_Category D) ->
    N_Base_Functor C D c d -> N_Base_Functor C D c d ->
    Sort (max (succ u) (succ z)) := N_NatTrans

def constructorQuantities : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : N_Base_Source_Category C) -> (d : N_Base_Target_Category D) ->
    (F : N_Base_Functor C D c d) -> (G : N_Base_Functor C D c d) ->
    (components : Components C D c d F G) -> Square C D c d F G components ->
    N_NatTrans C D c d F G := N_mk

def appQuantities : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : N_Base_Source_Category C) -> (d : N_Base_Target_Category D) ->
    (F : N_Base_Functor C D c d) -> (G : N_Base_Functor C D c d) ->
    N_NatTrans C D c d F G -> Components C D c d F G := N_app

def naturalityQuantities : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : N_Base_Source_Category C) -> (d : N_Base_Target_Category D) ->
    (F : N_Base_Functor C D c d) -> (G : N_Base_Functor C D c d) ->
    (alpha : N_NatTrans C D c d F G) -> Square C D c d F G (N_app C D c d F G alpha) :=
  N_naturality

def sourceHomLevel : (0 C : Sort (succ u)) -> (c : N_Base_Source_Category C) ->
    (x : C) -> (y : C) -> Sort (succ v) :=
  fun (0 C : Sort (succ u)) (c : N_Base_Source_Category C) (x : C) (y : C) =>
    N_Base_Source_Hom C c x y
end

specialize CompatibilityNatTransComputations (0, 1, 2, 3) as CompatibilityNatTransLow
specialize CompatibilityNatTransComputations (2, 0, 1, 3) as CompatibilityNatTransMixed
specialize CompatibilityNatTransComputations (3, 2, 0, 1) as CompatibilityNatTransHigh
