-- Generic stored-field computations and exact record and quantity pins.
poly (u, v, w, z, p, q) group CompatibilityLeftKan where
specialize MechSignatureLeftKan (u, v, w, z, p, q) as Candidate
specialize MechSignatureEq ((max (max (max (succ w) (succ p)) (succ z)) (succ q))) as Equality_functor
specialize MechSignatureEq ((max (succ u) (succ q))) as Equality_unit
specialize MechSignatureEq ((max (succ w) (succ q))) as Equality_desc
specialize MechSignatureEq (0) as Equality_fac
specialize MechSignatureEq (0) as Equality_uniq

def LField : (0 C : (Sort (succ u))) ->
    (0 D : (Sort (succ w))) ->
    (0 E : (Sort (succ p))) ->
    (c : (Candidate_Base_Source_Category C)) ->
    (d : (Candidate_Base_Middle_Category D)) ->
    (e : (Candidate_Base_Target_Category E)) ->
    (K : (Candidate_Base_First_Base_Functor C D c d)) ->
    (F : (Candidate_Base_Composite_Base_Functor C E c e)) ->
    Sort (max (max (max (succ w) (succ p)) (succ z)) (succ q)) :=
  fun (0 C : (Sort (succ u)))
      (0 D : (Sort (succ w)))
      (0 E : (Sort (succ p)))
      (c : (Candidate_Base_Source_Category C))
      (d : (Candidate_Base_Middle_Category D))
      (e : (Candidate_Base_Target_Category E))
      (K : (Candidate_Base_First_Base_Functor C D c d))
      (F : (Candidate_Base_Composite_Base_Functor C E c e)) =>
    (Candidate_Base_Second_Base_Functor D E d e)

