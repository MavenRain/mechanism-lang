-- Component proofs quantify over arbitrary fields; pins fix order and quantities.
poly (u, v, w, z) group CompatibilityFunctorComputations where
specialize MechSignatureFunctor (u, v, w, z) as F
specialize MechSignatureEq ((succ w)) as Objects
specialize MechSignatureEq (0) as Proofs

def objectProjection : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) ->
    (objects : C -> D) ->
    (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
      F_Target_Hom D d (objects x) (objects y)) ->
    (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
      (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x))) ->
    (composition : (x : C) -> (y : C) -> (a : C) ->
      (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
      F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
        (morphisms x a (F_Source_comp C c x y a f g))
        (F_Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g))) ->
    (x : C) -> Objects D
      (F_obj C D c d (F_mk C D c d objects morphisms identities composition) x)
      (objects x) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : F_Source_Category C) (d : F_Target_Category D)
      (objects : C -> D)
      (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
        F_Target_Hom D d (objects x) (objects y))
      (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
        (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x)))
      (composition : (x : C) -> (y : C) -> (a : C) ->
        (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
        F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
          (morphisms x a (F_Source_comp C c x y a f g))
          (F_Target_comp D d (objects x) (objects y) (objects a)
            (morphisms x y f) (morphisms y a g))) =>
    fun (x : C) => Objects_refl D (objects x)

def morphismProjection : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) ->
    (objects : C -> D) ->
    (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
      F_Target_Hom D d (objects x) (objects y)) ->
    (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
      (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x))) ->
    (composition : (x : C) -> (y : C) -> (a : C) ->
      (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
      F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
        (morphisms x a (F_Source_comp C c x y a f g))
        (F_Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g))) ->
    (x : C) -> (y : C) -> (f : F_Source_Hom C c x y) ->
    F_Target_Eq (F_Target_Hom D d (objects x) (objects y))
      (F_map C D c d (F_mk C D c d objects morphisms identities composition) x y f)
      (morphisms x y f) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : F_Source_Category C) (d : F_Target_Category D)
      (objects : C -> D)
      (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
        F_Target_Hom D d (objects x) (objects y))
      (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
        (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x)))
      (composition : (x : C) -> (y : C) -> (a : C) ->
        (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
        F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
          (morphisms x a (F_Source_comp C c x y a f g))
          (F_Target_comp D d (objects x) (objects y) (objects a)
            (morphisms x y f) (morphisms y a g))) =>
    fun (x : C) (y : C) (f : F_Source_Hom C c x y) =>
      F_Target_Eq_refl (F_Target_Hom D d (objects x) (objects y)) (morphisms x y f)

def identityProjection : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) ->
    (objects : C -> D) ->
    (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
      F_Target_Hom D d (objects x) (objects y)) ->
    (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
      (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x))) ->
    (composition : (x : C) -> (y : C) -> (a : C) ->
      (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
      F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
        (morphisms x a (F_Source_comp C c x y a f g))
        (F_Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g))) ->
    (x : C) -> Proofs
      (F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
        (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x)))
      (F_map_id C D c d (F_mk C D c d objects morphisms identities composition) x)
      (identities x) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : F_Source_Category C) (d : F_Target_Category D)
      (objects : C -> D)
      (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
        F_Target_Hom D d (objects x) (objects y))
      (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
        (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x)))
      (composition : (x : C) -> (y : C) -> (a : C) ->
        (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
        F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
          (morphisms x a (F_Source_comp C c x y a f g))
          (F_Target_comp D d (objects x) (objects y) (objects a)
            (morphisms x y f) (morphisms y a g))) =>
    fun (x : C) => Proofs_refl
      (F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
        (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x)))
      (identities x)

def compositionProjection : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) ->
    (objects : C -> D) ->
    (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
      F_Target_Hom D d (objects x) (objects y)) ->
    (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
      (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x))) ->
    (composition : (x : C) -> (y : C) -> (a : C) ->
      (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
      F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
        (morphisms x a (F_Source_comp C c x y a f g))
        (F_Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g))) ->
    (x : C) -> (y : C) -> (a : C) ->
    (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) -> Proofs
      (F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
        (morphisms x a (F_Source_comp C c x y a f g))
        (F_Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g)))
      (F_map_comp C D c d (F_mk C D c d objects morphisms identities composition) x y a f g)
      (composition x y a f g) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : F_Source_Category C) (d : F_Target_Category D)
      (objects : C -> D)
      (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
        F_Target_Hom D d (objects x) (objects y))
      (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
        (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x)))
      (composition : (x : C) -> (y : C) -> (a : C) ->
        (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
        F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
          (morphisms x a (F_Source_comp C c x y a f g))
          (F_Target_comp D d (objects x) (objects y) (objects a)
            (morphisms x y f) (morphisms y a g))) =>
    fun (x : C) (y : C) (a : C) (f : F_Source_Hom C c x y) (g : F_Source_Hom C c y a) =>
      Proofs_refl
      (F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
        (morphisms x a (F_Source_comp C c x y a f g))
        (F_Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g)))
      (composition x y a f g)

def storedMorphisms : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) ->
    (objects : C -> D) ->
    (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
      F_Target_Hom D d (objects x) (objects y)) ->
    (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
      (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x))) ->
    (composition : (x : C) -> (y : C) -> (a : C) ->
      (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
      F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
        (morphisms x a (F_Source_comp C c x y a f g))
        (F_Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g))) ->
    (x : C) -> (y : C) -> (f : F_Source_Hom C c x y) ->
    F_Target_Eq (F_Target_Hom D d (objects x) (objects y))
      ((F_mk C D c d objects morphisms identities composition).2.1 x y f)
      (morphisms x y f) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : F_Source_Category C) (d : F_Target_Category D)
      (objects : C -> D)
      (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
        F_Target_Hom D d (objects x) (objects y))
      (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
        (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x)))
      (composition : (x : C) -> (y : C) -> (a : C) ->
        (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
        F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
          (morphisms x a (F_Source_comp C c x y a f g))
          (F_Target_comp D d (objects x) (objects y) (objects a)
            (morphisms x y f) (morphisms y a g))) =>
    fun (x : C) (y : C) (f : F_Source_Hom C c x y) =>
      F_Target_Eq_refl (F_Target_Hom D d (objects x) (objects y)) (morphisms x y f)

def storedIdentity : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) ->
    (objects : C -> D) ->
    (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
      F_Target_Hom D d (objects x) (objects y)) ->
    (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
      (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x))) ->
    (composition : (x : C) -> (y : C) -> (a : C) ->
      (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
      F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
        (morphisms x a (F_Source_comp C c x y a f g))
        (F_Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g))) ->
    (x : C) -> Proofs
      (F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
        (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x)))
      ((F_mk C D c d objects morphisms identities composition).2.2.1 x)
      (identities x) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : F_Source_Category C) (d : F_Target_Category D)
      (objects : C -> D)
      (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
        F_Target_Hom D d (objects x) (objects y))
      (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
        (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x)))
      (composition : (x : C) -> (y : C) -> (a : C) ->
        (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
        F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
          (morphisms x a (F_Source_comp C c x y a f g))
          (F_Target_comp D d (objects x) (objects y) (objects a)
            (morphisms x y f) (morphisms y a g))) =>
    fun (x : C) => Proofs_refl
      (F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
        (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x)))
      (identities x)

def storedComposition : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) ->
    (objects : C -> D) ->
    (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
      F_Target_Hom D d (objects x) (objects y)) ->
    (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
      (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x))) ->
    (composition : (x : C) -> (y : C) -> (a : C) ->
      (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
      F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
        (morphisms x a (F_Source_comp C c x y a f g))
        (F_Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g))) ->
    (x : C) -> (y : C) -> (a : C) ->
    (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) -> Proofs
      (F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
        (morphisms x a (F_Source_comp C c x y a f g))
        (F_Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g)))
      ((F_mk C D c d objects morphisms identities composition).2.2.2 x y a f g)
      (composition x y a f g) :=
  fun (0 C : Sort (succ u)) (0 D : Sort (succ w))
      (c : F_Source_Category C) (d : F_Target_Category D)
      (objects : C -> D)
      (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
        F_Target_Hom D d (objects x) (objects y))
      (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
        (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x)))
      (composition : (x : C) -> (y : C) -> (a : C) ->
        (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
        F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
          (morphisms x a (F_Source_comp C c x y a f g))
          (F_Target_comp D d (objects x) (objects y) (objects a)
            (morphisms x y f) (morphisms y a g))) =>
    fun (x : C) (y : C) (a : C) (f : F_Source_Hom C c x y) (g : F_Source_Hom C c y a) =>
      Proofs_refl
      (F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
        (morphisms x a (F_Source_comp C c x y a f g))
        (F_Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g)))
      (composition x y a f g)

def functorQuantities : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) ->
    Sort (max (max (max (succ u) (succ w)) (succ v)) (succ z)) := F_Functor

def mkQuantities : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) ->
    (objects : C -> D) ->
    (morphisms : (x : C) -> (y : C) -> F_Source_Hom C c x y ->
      F_Target_Hom D d (objects x) (objects y)) ->
    (identities : (x : C) -> F_Target_Eq (F_Target_Hom D d (objects x) (objects x))
      (morphisms x x (F_Source_id C c x)) (F_Target_id D d (objects x))) ->
    (composition : (x : C) -> (y : C) -> (a : C) ->
      (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
      F_Target_Eq (F_Target_Hom D d (objects x) (objects a))
        (morphisms x a (F_Source_comp C c x y a f g))
        (F_Target_comp D d (objects x) (objects y) (objects a)
          (morphisms x y f) (morphisms y a g))) ->
    F_Functor C D c d := F_mk

def objQuantities : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) ->
    F_Functor C D c d -> C -> D := F_obj

def mapQuantities : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) -> (F : F_Functor C D c d) ->
    (x : C) -> (y : C) -> F_Source_Hom C c x y ->
    F_Target_Hom D d (F_obj C D c d F x) (F_obj C D c d F y) := F_map

def mapIdQuantities : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) -> (F : F_Functor C D c d) ->
    (x : C) -> F_Target_Eq (F_Target_Hom D d (F_obj C D c d F x) (F_obj C D c d F x))
      (F_map C D c d F x x (F_Source_id C c x)) (F_Target_id D d (F_obj C D c d F x)) :=
  F_map_id

def mapCompQuantities : (0 C : Sort (succ u)) -> (0 D : Sort (succ w)) ->
    (c : F_Source_Category C) -> (d : F_Target_Category D) -> (F : F_Functor C D c d) ->
    (x : C) -> (y : C) -> (a : C) ->
    (f : F_Source_Hom C c x y) -> (g : F_Source_Hom C c y a) ->
    F_Target_Eq (F_Target_Hom D d (F_obj C D c d F x) (F_obj C D c d F a))
      (F_map C D c d F x a (F_Source_comp C c x y a f g))
      (F_Target_comp D d (F_obj C D c d F x) (F_obj C D c d F y) (F_obj C D c d F a)
        (F_map C D c d F x y f) (F_map C D c d F y a g)) := F_map_comp
end

poly (u, v, w, z) group CompatibilityFunctorSymbolicClient where
specialize CompatibilityFunctorComputations (u, v, w, z) as Checked
end

specialize CompatibilityFunctorComputations (0, 0, 1, 1) as LargerTarget
specialize CompatibilityFunctorComputations (1, 2, 0, 1) as LargerSource
specialize CompatibilityFunctorComputations (2, 1, 2, 0) as IndependentMorphisms
