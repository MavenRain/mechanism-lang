-- Reuse the indexed categories, cocones and solvers of shared-left-kan-runtime.
specialize MechLeftKanLaws (0, 1, 0, 0, 1, 0) as Laws
  with (Base_Base_Source := Run_Base_Source, Base_Base_Middle := Run_Base_Middle,
        Base_Base_Target := Run_Base_Target)
specialize MechCategoryCore (1, 0) as SeparateTarget

def IdentityChosen : Run_Lan_LanSolution Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Eta Eta :=
  Run_Lan_lanSolve Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Extension Constant Eta
def IdentityMediator : Run_Base_Second_NatTrans Nat Point IndexedPlain DoubleEnd Constant Constant :=
  Run_descNat Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Eta Eta IdentityChosen
def identityLaw : (y : Nat) -> Run_Base_Target ((Nat -> Nat) * (Nat -> Nat))
    (IdentityMediator.1 y) (Run_Base_Target_id Point DoubleEnd point) :=
  Laws_descId Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant Eta IdentityChosen

-- Choose the external transformation itself, with an independent solution record.
def AlternativeChosen : Run_Lan_LanSolution Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Eta Cocone :=
  (Alpha, (externalFactorWitness,
    (fun (other : Run_Base_Second_NatTrans Nat Point IndexedPlain DoubleEnd Constant Constant)
        (factor : Run_Lan_LanFactor Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
          Constant Constant Eta Cocone other) =>
      Run_Lan_desc_unique Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
        Constant Constant Eta Cocone Chosen other Alpha factor externalFactorWitness)))
def otherExternalFactor : Run_Lan_LanFactor Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Eta OtherCocone Beta :=
  fun (x : Nat) => Run_Base_Target_idComp Point DoubleEnd point point (Beta.1 x)
def AlternativeOtherChosen : Run_Lan_LanSolution Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Eta OtherCocone :=
  (Beta, (otherExternalFactor,
    (fun (other : Run_Base_Second_NatTrans Nat Point IndexedPlain DoubleEnd Constant Constant)
        (factor : Run_Lan_LanFactor Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
          Constant Constant Eta OtherCocone other) =>
      Run_Lan_desc_unique Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
        Constant Constant Eta OtherCocone OtherChosen other Beta factor otherExternalFactor)))
def congrLaw : (y : Nat) -> Run_Base_Target ((Nat -> Nat) * (Nat -> Nat))
    (Mediator.1 y) (Alpha.1 y) :=
  Laws_descCongr Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Eta Cocone Cocone Chosen AlternativeChosen (fun (x : Nat) => categoryRefl)
def otherCongrLaw : (y : Nat) -> Run_Base_Target ((Nat -> Nat) * (Nat -> Nat))
    (OtherMediator.1 y) (Beta.1 y) :=
  Laws_descCongr Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Eta OtherCocone OtherCocone OtherChosen AlternativeOtherChosen
    (fun (x : Nat) => categoryRefl)

-- The checker needs an equality proof, which the law supplies; both closure fields contribute after erasure.
def lanCertified : (left : (Nat -> Nat) * (Nat -> Nat)) ->
    (0 right : (Nat -> Nat) * (Nat -> Nat)) ->
    (0 proof : Run_Base_Target ((Nat -> Nat) * (Nat -> Nat)) left right) -> Nat -> Nat :=
  fun (left : (Nat -> Nat) * (Nat -> Nat)) (0 right : (Nat -> Nat) * (Nat -> Nat))
      (0 proof : Run_Base_Target ((Nat -> Nat) * (Nat -> Nat)) left right) (n : Nat) =>
    natAdd (natMul 101 (left.1 (natAdd n 7))) (left.2 (natAdd n 11))
def lanIdentityAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (IdentityMediator.1 x) (Run_Base_Target_id Point DoubleEnd point) (identityLaw x) x
def lanIdentityReferenceAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (Run_Base_Target_id Point DoubleEnd point) (Run_Base_Target_id Point DoubleEnd point)
    categoryRefl x
def lanCongrAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (Mediator.1 x) (Alpha.1 x) (congrLaw x) x
def lanCongrReferenceAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (Alpha.1 x) (Alpha.1 x) categoryRefl x
def lanOtherCongrAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (OtherMediator.1 x) (Beta.1 x) (otherCongrLaw x) x
def lanOtherCongrReferenceAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (Beta.1 x) (Beta.1 x) categoryRefl x
def lanIdentity : Nat := lanIdentityAt sharedLanInput
def lanIdentityReference : Nat := lanIdentityReferenceAt sharedLanInput
def lanCongr : Nat := lanCongrAt sharedLanInput
def lanCongrReference : Nat := lanCongrReferenceAt sharedLanInput
def lanOtherCongr : Nat := lanOtherCongrAt sharedLanInput
def lanOtherCongrReference : Nat := lanOtherCongrReferenceAt sharedLanInput

-- Both orders use independently solved cocones and noncommuting components.
def PostCocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Cocone Beta
def ReversePostCocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant OtherCocone Alpha
def PostChosen : Run_Lan_LanSolution Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Eta PostCocone :=
  Run_Lan_lanSolve Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Extension Constant PostCocone
def ReversePostChosen : Run_Lan_LanSolution Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Eta ReversePostCocone :=
  Run_Lan_lanSolve Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Extension Constant ReversePostCocone
def postLaw : (y : Nat) -> Run_Base_Target ((Nat -> Nat) * (Nat -> Nat))
    (Run_Base_Target_comp Point DoubleEnd point point point (Mediator.1 y) (Beta.1 y))
    ((PostChosen.1).1 y) :=
  Laws_descPostcomp Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Constant Eta Cocone Beta Chosen PostChosen
def reversePostLaw : (y : Nat) -> Run_Base_Target ((Nat -> Nat) * (Nat -> Nat))
    (Run_Base_Target_comp Point DoubleEnd point point point (OtherMediator.1 y) (Alpha.1 y))
    ((ReversePostChosen.1).1 y) :=
  Laws_descPostcomp Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Constant Eta OtherCocone Alpha OtherChosen ReversePostChosen
def lanPostcompAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (Run_Base_Target_comp Point DoubleEnd point point point (Mediator.1 x) (Beta.1 x))
    ((PostChosen.1).1 x) (postLaw x) x
def lanPostcompReferenceAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified ((PostChosen.1).1 x) ((PostChosen.1).1 x) categoryRefl x
def lanReversePostcompAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (Run_Base_Target_comp Point DoubleEnd point point point (OtherMediator.1 x) (Alpha.1 x))
    ((ReversePostChosen.1).1 x) (reversePostLaw x) x
def lanReversePostcompReferenceAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified ((ReversePostChosen.1).1 x) ((ReversePostChosen.1).1 x) categoryRefl x
def lanPostcomp : Nat := lanPostcompAt sharedLanInput
def lanPostcompReference : Nat := lanPostcompReferenceAt sharedLanInput
def lanReversePostcomp : Nat := lanReversePostcompAt sharedLanInput
def lanReversePostcompReference : Nat := lanReversePostcompReferenceAt sharedLanInput

-- Identity and both composition orders use the checked cocone laws.
def IdentityPostCocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Cocone (Run_Base_Second_idNat Nat Point IndexedPlain DoubleEnd Constant)
def NestedPostCocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant Constant
    (Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
      Constant Constant Cocone Alpha) Beta
def CompositePostCocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant Constant Cocone
    (Run_Base_Second_vcomp Nat Point IndexedPlain DoubleEnd Constant Constant Constant Alpha Beta)
def ReverseNestedPostCocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant Constant
    (Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
      Constant Constant Cocone Beta) Alpha
def ReverseCompositePostCocone : Run_Lan_LanCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant :=
  Laws_postCocone Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant Constant Cocone
    (Run_Base_Second_vcomp Nat Point IndexedPlain DoubleEnd Constant Constant Constant Beta Alpha)
def postIdentityLaw : Laws_CoconeEq Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant IdentityPostCocone Cocone :=
  Laws_postCoconeId Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original Constant Cocone
def postVcompLaw : Laws_CoconeEq Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant NestedPostCocone CompositePostCocone :=
  Laws_postCoconeVcomp Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Constant Cocone Alpha Beta
def postReverseVcompLaw : Laws_CoconeEq Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant ReverseNestedPostCocone ReverseCompositePostCocone :=
  Laws_postCoconeVcomp Nat Nat Point IndexedEnd IndexedPlain DoubleEnd Forget Original
    Constant Constant Constant Cocone Beta Alpha
def lanPostIdentityAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (IdentityPostCocone.1 x) (Cocone.1 x) (postIdentityLaw x) x
def lanPostIdentityReferenceAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (Cocone.1 x) (Cocone.1 x) categoryRefl x
def lanPostVcompAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (NestedPostCocone.1 x) (CompositePostCocone.1 x) (postVcompLaw x) x
def lanPostVcompReferenceAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (CompositePostCocone.1 x) (CompositePostCocone.1 x) categoryRefl x
def lanPostReverseVcompAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (ReverseNestedPostCocone.1 x) (ReverseCompositePostCocone.1 x) (postReverseVcompLaw x) x
def lanPostReverseVcompReferenceAt : Nat -> Nat := fun (x : Nat) =>
  lanCertified (ReverseCompositePostCocone.1 x) (ReverseCompositePostCocone.1 x) categoryRefl x
def lanPostIdentity : Nat := lanPostIdentityAt sharedLanInput
def lanPostIdentityReference : Nat := lanPostIdentityReferenceAt sharedLanInput
def lanPostVcomp : Nat := lanPostVcompAt sharedLanInput
def lanPostVcompReference : Nat := lanPostVcompReferenceAt sharedLanInput
def lanPostReverseVcomp : Nat := lanPostReverseVcompAt sharedLanInput
def lanPostReverseVcompReference : Nat := lanPostReverseVcompReferenceAt sharedLanInput
