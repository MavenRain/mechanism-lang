  Laws_whiskerRightId Nat Nat Point IndexedEnd End PairEnd Embed Left
def rightIdLeftAt : Nat -> Nat := certifiedWhisker (Run_Compose_Base_compFunctor Nat Nat Point IndexedEnd End PairEnd Embed Left) (Run_Compose_Base_compFunctor Nat Nat Point IndexedEnd End PairEnd Embed Left) rightIdLhs rightIdRhs rightIdLaw
