-- Load shared-nattrans-runtime.mech first.
specialize MechWhiskeringLaws (0, 1, 0, 0, 1, 0) as Laws
  with (Ops_Source := Run_Source, Ops_Middle := Run_Middle, Ops_Target := Run_Target)

-- Delta after Beta discards the second input. The opposite order discards the first.
def Embed : External_Functor Nat Nat IndexedEnd End :=
  ((fun (x : Nat) => x),
   ((fun (0 x : Nat) (0 y : Nat)
         (f : (Path x y) * ((0 A : Type 0) -> Nat -> Nat)) (n : Nat) => f.2 Nat n),
    ((fun (0 x : Nat) => categoryRefl),
     (fun (0 x : Nat) (0 y : Nat) (0 z : Nat)
          (0 f : (Path x y) * ((0 A : Type 0) -> Nat -> Nat))
          (0 g : (Path y z) * ((0 A : Type 0) -> Nat -> Nat)) => categoryRefl))))
def Delta : Run_Second_NatTrans Nat Point End PairEnd Right Left :=
  ((fun (x : Nat) (n : Nat * Nat) => (n.2, 5)),
   (fun (0 x : Nat) (0 y : Nat) (f : Nat -> Nat) => categoryRefl))
def FirstIdentityAlpha : Run_First_NatTrans Nat Nat IndexedEnd End (Constant 0) (Constant 1) :=
  Run_First_vcomp Nat Nat IndexedEnd End (Constant 0) (Constant 0) (Constant 1)
    (Run_First_idNat Nat Nat IndexedEnd End (Constant 0)) Alpha
def SecondIdentityBeta : Run_Second_NatTrans Nat Point End PairEnd Left Right :=
  Run_Second_vcomp Nat Point End PairEnd Left Left Right
    (Run_Second_idNat Nat Point End PairEnd Left) Beta
def pairCode : (Nat * Nat) -> Nat := fun (n : Nat * Nat) => natAdd (natMul n.1 100) n.2
def certifiedWhisker : (F : Run_Composite_Base_Functor Nat Point IndexedEnd PairEnd) ->
    (G : Run_Composite_Base_Functor Nat Point IndexedEnd PairEnd) ->
    (alpha : Run_Composite_NatTrans Nat Point IndexedEnd PairEnd F G) ->
    (beta : Run_Composite_NatTrans Nat Point IndexedEnd PairEnd F G) ->
    (0 proof : Laws_Composite_NatTransEq Nat Point IndexedEnd PairEnd F G alpha beta) -> Nat -> Nat :=
  fun (F : Run_Composite_Base_Functor Nat Point IndexedEnd PairEnd)
      (G : Run_Composite_Base_Functor Nat Point IndexedEnd PairEnd)
      (alpha : Run_Composite_NatTrans Nat Point IndexedEnd PairEnd F G)
      (beta : Run_Composite_NatTrans Nat Point IndexedEnd PairEnd F G)
      (0 proof : Laws_Composite_NatTransEq Nat Point IndexedEnd PairEnd F G alpha beta)
      (x : Nat) => pairCode (alpha.1 x (F.2.1 x x (same, (fun (0 A : Type 0) (n : Nat) => natMul n 2)) (natAdd x 13, 7)))

