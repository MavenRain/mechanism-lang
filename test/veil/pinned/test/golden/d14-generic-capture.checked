def id : (Ran SPi 0 A Type 1 (Ran SPi w x A A)) := (Sec SPi 0 A Type 1 [A => (Sec SPi w x A [x => x])])
def mk : (Ran SPi w x Nat (Lan SPi w f (Ran SPi w _ Nat Nat) Nat)) := (Sec SPi w x Nat [x => let z : Nat := (Out SPi w x Nat (APt w x) (Out SPi 0 A Type 1 (APt 0 Nat) id)) in (In SPi w f (Ran SPi w _ Nat Nat) (APt w (Sec SPi w y Nat [y => (Out SPi w b Nat (APt w y) (Out SPi w a Nat (APt w z) natAdd))])) [z])])
def main : Nat := (Out SPi w _ Nat (APt w 6) (Elim SPi w f (Ran SPi w _ Nat Nat) (Out SPi w x Nat (APt w 5) mk) as self return (Ran SPi w _ Nat Nat) with | (ALeg 0) x y => x))
