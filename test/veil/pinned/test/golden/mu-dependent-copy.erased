rec [mu<V>; leg<mu<V>,0>; leg<mu<V>,1,union nat,union mu<V>>]
fun copy (union mu<V>) : union mu<V> := KCase mu<V> (KVar 0) [{0 0 (KTag mu<V> 0 [])}; {1 2 (KTag mu<V> 1 [KVar 1; KApp (KGlobal copy) [KVar 0]])}]
rec [mu<V>; nat; leg<mu<V>,0>; leg<mu<V>,1,union nat,union mu<V>>]
fun total (union mu<V>) : union nat := KCase mu<V> (KVar 0) [{0 0 (KLit 0)}; {1 2 (KTail (KGlobal natAdd) [KVar 1; KApp (KGlobal total) [KVar 0]])}]
rec [mu<V>; leg<mu<V>,0>; leg<mu<V>,1,union nat,union mu<V>>]
fun empty () : union mu<V> := KTail (KGlobal copy) [KTag mu<V> 0 []]
rec [mu<V>; leg<mu<V>,0>; leg<mu<V>,1,union nat,union mu<V>>]
fun values () : union mu<V> := KTag mu<V> 1 [KLit 17; KTag mu<V> 1 [KLit 25; KGlobal empty]]
rec [mu<V>]
fun copied () : union mu<V> := KTail (KGlobal copy) [KGlobal values]
rec [nat]
fun main () : union nat := KTail (KGlobal total) [KGlobal copied]
