rec [any]
fun id (union any) : union any := KVar 0
rec [any; pair<union any,union any>]
fun box (union any) : struct pair<union any,union any> := KStruct pair<union any,union any> [KVar 0; KVar 0]
rec [pair<union any,union any>; any]
fun first (struct pair<union any,union any>) : union any := KLet scrut (KVar 0) (KLet a (KProj pair<union any,union any> 0 (KVar 0)) (KLet y (KProj pair<union any,union any> 1 (KVar 1)) (KVar 1)))
rec [any; tuple<union any,union any>]
fun pack (union any) : struct tuple<union any,union any> := KStruct tuple<union any,union any> [KVar 0; KVar 0]
rec [any; sum<union any|union any>]
fun choose (union any) : union sum<union any|union any> := KTag sum<union any|union any> 1 [KVar 0]
rec [sum<union any|union any>; any]
fun unchoose (union sum<union any|union any>) : union any := KCase sum<union any|union any> (KVar 0) [{0 1 (KVar 0)}; {1 1 (KVar 0)}]
rec [nat; any]
fun fromEmpty () : union nat := KCase any (KErased) []
rec [nat; sum<union nat|union nat>]
fun sumNat () : union nat := KCase sum<union nat|union nat> (KApp (KGlobal id) [KApp (KGlobal choose) [KLit 7]]) [{0 1 (KVar 0)}; {1 1 (KTail (KGlobal natAdd) [KVar 0; KLit 1])}]
rec [nat; pair<struct pair<union nat,union nat>,struct pair<union nat,union nat>>; pair<union nat,union nat>]
fun nested () : union nat := KLet scrut (KLet scrut (KApp (KGlobal box) [KApp (KGlobal box) [KLit 5]]) (KLet a (KProj pair<struct pair<union nat,union nat>,struct pair<union nat,union nat>> 0 (KVar 0)) (KLet y (KProj pair<struct pair<union nat,union nat>,struct pair<union nat,union nat>> 1 (KVar 1)) (KVar 1)))) (KLet a (KProj pair<union nat,union nat> 0 (KVar 0)) (KLet y (KProj pair<union nat,union nat> 1 (KVar 1)) (KVar 0)))
rec [nat]
fun inc (union nat) : union nat := KTail (KGlobal natAdd) [KVar 0; KLit 1]
rec [nat; tuple<func fn<1>,func fn<1>>]
fun fromClosure () : union nat := KTail (KProj tuple<func fn<1>,func fn<1>> 0 (KApp (KGlobal pack) [KGlobal inc])) [KLit 8]
rec [nat; pair<union nat,union nat>; tuple<union nat,union nat>; sum<union nat|union nat>]
fun main () : union nat := KTail (KGlobal natAdd) [KApp (KGlobal natAdd) [KApp (KGlobal first) [KStruct pair<union nat,union nat> [KLit 3; KLit 4]]; KProj tuple<union nat,union nat> 1 (KApp (KGlobal pack) [KLit 9])]; KApp (KGlobal natAdd) [KApp (KGlobal unchoose) [KTag sum<union nat|union nat> 0 [KLit 2]]; KApp (KGlobal natAdd) [KGlobal sumNat; KApp (KGlobal natAdd) [KGlobal nested; KGlobal fromClosure]]]]
