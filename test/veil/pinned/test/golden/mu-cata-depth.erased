rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun dbl (union mu<N>) : union mu<N> := KCase mu<N> (KVar 0) [{0 0 (KTag mu<N> 0 [])}; {1 1 (KTag mu<N> 1 [KTag mu<N> 1 [KApp (KGlobal dbl) [KVar 0]]])}]
rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun n0 () : union mu<N> := KTag mu<N> 1 [KTag mu<N> 0 []]
rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun n1 () : union mu<N> := KTag mu<N> 1 [KApp (KGlobal dbl) [KGlobal n0]]
rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun n2 () : union mu<N> := KTag mu<N> 1 [KApp (KGlobal dbl) [KGlobal n1]]
rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun n3 () : union mu<N> := KTag mu<N> 1 [KApp (KGlobal dbl) [KGlobal n2]]
rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun n4 () : union mu<N> := KTag mu<N> 1 [KApp (KGlobal dbl) [KGlobal n3]]
rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun n5 () : union mu<N> := KTag mu<N> 1 [KApp (KGlobal dbl) [KGlobal n4]]
rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun n6 () : union mu<N> := KTag mu<N> 1 [KApp (KGlobal dbl) [KGlobal n5]]
rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun n7 () : union mu<N> := KTag mu<N> 1 [KApp (KGlobal dbl) [KGlobal n6]]
rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun n8 () : union mu<N> := KTag mu<N> 1 [KApp (KGlobal dbl) [KGlobal n7]]
rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun n9 () : union mu<N> := KTag mu<N> 1 [KApp (KGlobal dbl) [KGlobal n8]]
rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun n10 () : union mu<N> := KTag mu<N> 1 [KApp (KGlobal dbl) [KGlobal n9]]
rec [mu<N>; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun n11 () : union mu<N> := KTag mu<N> 1 [KApp (KGlobal dbl) [KGlobal n10]]
rec [mu<N>; nat; leg<mu<N>,0>; leg<mu<N>,1,union mu<N>>]
fun toNat (union mu<N>) : union nat := KCase mu<N> (KVar 0) [{0 0 (KLit 0)}; {1 1 (KTail (KGlobal natAdd) [KLit 1; KApp (KGlobal toNat) [KVar 0]])}]
rec [nat]
fun main () : union nat := KTail (KGlobal natAdd) [KLit 0; KApp (KGlobal toNat) [KGlobal n11]]
