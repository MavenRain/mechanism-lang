def step : (Ran SPi w a Nat (Ran SPi w b Nat Nat)) := (Sec SPi w a Nat [a => (Sec SPi w b Nat [b => (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w a) natAdd))])])
def chain : (Ran SPi w a Nat (Ran SPi w b Nat Nat)) := (Sec SPi w a Nat [a => (Sec SPi w b Nat [b => (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w (Out SPi w b Nat (APt w 1) (Out SPi w a Nat (APt w a) natAdd))) step))])])
def outer : (Ran SPi w a Nat (Ran SPi w b Nat Nat)) := (Sec SPi w a Nat [a => (Sec SPi w b Nat [b => (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w (Out SPi w b Nat (APt w 2) (Out SPi w a Nat (APt w a) natAdd))) chain))])])
def main : Nat := (Out SPi w b Nat (APt w 4) (Out SPi w a Nat (APt w 3) outer))
