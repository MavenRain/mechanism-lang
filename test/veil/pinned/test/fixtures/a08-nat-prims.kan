-- a08: the nat literals and the five prims.  Every prim applies by
-- juxtaposition (SA-D1).  "sum" and "prod" are reserved from Stage B
-- (SB-D1), so the two definitions that carried those names in Stage A
-- read "total" and "product" here.

axiom Nat : Type 0

def Bool : Type 0 := sum ((prod () : Type 0), (prod () : Type 0))

def total : Nat := natAdd 2 3
def diff : Nat := natSub 5 1
def product : Nat := natMul 6 7
def same : Bool := natEq 4 4
def less : Bool := natLt 1 2
def mixed : Nat := natAdd (natMul 2 3) 4
