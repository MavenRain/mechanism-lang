-- Focused exact runtime arithmetic, expected main result 32.

def Bool : Type 0 := sum ((prod () : Type 0), (prod () : Type 0))

def boolNat : Bool -> Nat := fun (b : Bool) => case b with | 0 (u : prod ()) => 0 | 1 (u : prod ()) => 1

def checkNat : Nat -> Nat -> Nat := fun (a : Nat) (b : Nat) => boolNat (natEq a b)

def smallAdd : Nat := checkNat (natAdd 1073741823 1) 1073741824

def smallMul : Nat := checkNat (natMul 32768 32768) 1073741824

def bigAdd : Nat := checkNat (natAdd 12345678901234567890123456789 9876543210123456789) 12345678911111111100246913578

