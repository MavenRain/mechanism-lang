def mixedMul : Nat := checkNat (natMul 12345678901234567890123456789 32767) 404530860556753086055675308605163

def reverseMul : Nat := checkNat (natMul 32767 12345678901234567890123456789) 404530860556753086055675308605163

def zeroMul : Nat := checkNat (natMul 12345678901234567890123456789 0) 0

def reverseZero : Nat := checkNat (natMul 0 12345678901234567890123456789) 0

def oneMul : Nat := checkNat (natMul 12345678901234567890123456789 1) 12345678901234567890123456789

def reverseOne : Nat := checkNat (natMul 1 12345678901234567890123456789) 12345678901234567890123456789

def demote : Nat := checkNat (natSub 12345678901234567890123456789 12345678901234567889049714966) 1073741823

def heterogeneous : Nat := checkNat (natSub 1073807363 1073807358) 5

def eqSame : Nat := checkNat (boolNat (natEq 12345678901234567890123456789 12345678901234567890123456789)) 1

def eqDifferent : Nat := checkNat (boolNat (natEq 12345678901234567890123456789 12345678901234567890123456790)) 0

def eqMixed : Nat := checkNat (boolNat (natEq 12345678901234567890123456789 3)) 0

def eqReverse : Nat := checkNat (boolNat (natEq 3 12345678901234567890123456789)) 0

def ltSame : Nat := checkNat (boolNat (natLt 12345678901234567890123456789 12345678901234567890123456789)) 0

def ltNext : Nat := checkNat (boolNat (natLt 12345678901234567890123456789 12345678901234567890123456790)) 1

def ltPrevious : Nat := checkNat (boolNat (natLt 12345678901234567890123456790 12345678901234567890123456789)) 0

def ltMixed : Nat := checkNat (boolNat (natLt 3 12345678901234567890123456789)) 1

def ltReverse : Nat := checkNat (boolNat (natLt 12345678901234567890123456789 3)) 0

def alias : Nat := let a : Nat := 12345678901234567890123456789 in let twice : Nat := natAdd a a in natAdd (checkNat a 12345678901234567890123456789) (checkNat twice 24691357802469135780246913578)

def partial : Nat := let mul : Nat -> Nat := natMul 12345678901234567890123456789 in checkNat (natSub (mul 3) 37037036703703703670370370365) 2

def main : Nat := natAdd smallAdd (natAdd smallMul (natAdd bigAdd (natAdd mixedAdd (natAdd reverseAdd (natAdd bigSub (natAdd mixedSub (natAdd truncated (natAdd zeroSub (natAdd borrow (natAdd carry (natAdd bigMul (natAdd mixedMul (natAdd reverseMul (natAdd zeroMul (natAdd reverseZero (natAdd oneMul (natAdd reverseOne (natAdd demote (natAdd heterogeneous (natAdd eqSame (natAdd eqDifferent (natAdd eqMixed (natAdd eqReverse (natAdd ltSame (natAdd ltNext (natAdd ltPrevious (natAdd ltMixed (natAdd ltReverse (natAdd alias (natAdd partial (0)))))))))))))))))))))))))))))))
