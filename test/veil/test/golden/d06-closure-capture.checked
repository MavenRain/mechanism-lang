def mk : (Ran SPi w x Nat (Lan SPi w f (Ran SPi w _ Nat Nat) Nat)) := (Sec SPi w x Nat [x => (In SPi w f (Ran SPi w _ Nat Nat) (APt w (Sec SPi w y Nat [y => (Out SArg w b (APt w y) (Out SArg w a (APt w x) natAdd))])) [(Out SArg w b (APt w 2) (Out SArg w a (APt w x) natMul))])])
def mkLet : (Ran SPi w x Nat (Lan SPi w f (Ran SPi w _ Nat Nat) Nat)) := (Sec SPi w x Nat [x => let z : Nat := (Out SArg w b (APt w 1) (Out SArg w a (APt w x) natAdd)) in (In SPi w f (Ran SPi w _ Nat Nat) (APt w (Sec SPi w y Nat [y => (Out SArg w b (APt w y) (Out SArg w a (APt w z) natAdd))])) [z])])
def main : Nat := (Out SArg w b (APt w (Out SArg w b (APt w (Elim SPi w f (Ran SPi w _ Nat Nat) (Out SArg w x (APt w 2) mkLet) as self return Nat with | (ALeg 0) x y => y)) (Out SArg w a (APt w (Out SArg w _ (APt w 4) (Elim SPi w f (Ran SPi w _ Nat Nat) (Out SArg w x (APt w 2) mkLet) as self return (Ran SPi w _ Nat Nat) with | (ALeg 0) x y => x))) natAdd))) (Out SArg w a (APt w (Out SArg w b (APt w (Elim SPi w f (Ran SPi w _ Nat Nat) (Out SArg w x (APt w 5) mk) as self return Nat with | (ALeg 0) x y => y)) (Out SArg w a (APt w (Out SArg w _ (APt w 6) (Elim SPi w f (Ran SPi w _ Nat Nat) (Out SArg w x (APt w 5) mk) as self return (Ran SPi w _ Nat Nat) with | (ALeg 0) x y => x))) natAdd))) natAdd))
