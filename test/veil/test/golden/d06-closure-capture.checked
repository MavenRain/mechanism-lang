def mk : (Ran SPi w x Nat (Lan SPi w f (Ran SPi w _ Nat Nat) Nat)) := (Sec SPi w x Nat [x => (In SPi w f (Ran SPi w _ Nat Nat) (APt w (Sec SPi w y Nat [y => (Out SPi w b Nat (APt w y) (Out SPi w a Nat (APt w x) natAdd))])) [(Out SPi w b Nat (APt w 2) (Out SPi w a Nat (APt w x) natMul))])])
def mkLet : (Ran SPi w x Nat (Lan SPi w f (Ran SPi w _ Nat Nat) Nat)) := (Sec SPi w x Nat [x => let z : Nat := (Out SPi w b Nat (APt w 1) (Out SPi w a Nat (APt w x) natAdd)) in (In SPi w f (Ran SPi w _ Nat Nat) (APt w (Sec SPi w y Nat [y => (Out SPi w b Nat (APt w y) (Out SPi w a Nat (APt w z) natAdd))])) [z])])
def main : Nat := (Out SPi w b Nat (APt w (Out SPi w b Nat (APt w (Elim SPi w f (Ran SPi w _ Nat Nat) (Out SPi w x Nat (APt w 2) mkLet) as self return Nat with | (ALeg 0) x y => y)) (Out SPi w a Nat (APt w (Out SPi w _ Nat (APt w 4) (Elim SPi w f (Ran SPi w _ Nat Nat) (Out SPi w x Nat (APt w 2) mkLet) as self return (Ran SPi w _ Nat Nat) with | (ALeg 0) x y => x))) natAdd))) (Out SPi w a Nat (APt w (Out SPi w b Nat (APt w (Elim SPi w f (Ran SPi w _ Nat Nat) (Out SPi w x Nat (APt w 5) mk) as self return Nat with | (ALeg 0) x y => y)) (Out SPi w a Nat (APt w (Out SPi w _ Nat (APt w 6) (Elim SPi w f (Ran SPi w _ Nat Nat) (Out SPi w x Nat (APt w 5) mk) as self return (Ran SPi w _ Nat Nat) with | (ALeg 0) x y => x))) natAdd))) natAdd))
