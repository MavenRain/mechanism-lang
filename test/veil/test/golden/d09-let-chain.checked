def Two : Type 1 := (Lan SColl 2 (Sec SColl 2 [ => Nat;  => Nat]))
def pick : (Ran SPi w s Two Nat) := (Sec SPi w s Two [s => let base : Nat := 10 in let bump : Nat := (Elim SColl 2 s with | (ALeg 0) a => (Out SPi w b Nat (APt w 1) (Out SPi w a Nat (APt w a) natAdd)) | (ALeg 1) b => (Out SPi w b Nat (APt w 2) (Out SPi w a Nat (APt w b) natMul))) in let total : Nat := (Out SPi w b Nat (APt w bump) (Out SPi w a Nat (APt w base) natAdd)) in (Out SPi w b Nat (APt w 100) (Out SPi w a Nat (APt w total) natAdd))])
def main : Nat := (Out SPi w b Nat (APt w (Out SPi w s (Lan SColl 2 (Sec SColl 2 [ => Nat;  => Nat])) (APt w (In SColl 2 (ALeg 1) [4])) pick)) (Out SPi w a Nat (APt w (Out SPi w s (Lan SColl 2 (Sec SColl 2 [ => Nat;  => Nat])) (APt w (In SColl 2 (ALeg 0) [3])) pick)) natAdd))
