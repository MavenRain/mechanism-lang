def Two : Type 1 := (Lan SColl 2 (Sec SColl 2 [ => Nat;  => Nat]))
def pick : (Ran SPi w s Two Nat) := (Sec SPi w s Two [s => let base : Nat := 10 in let bump : Nat := (Elim SColl 2 s with | (ALeg 0) a => (Out SArg w b (APt w 1) (Out SArg w a (APt w a) natAdd)) | (ALeg 1) b => (Out SArg w b (APt w 2) (Out SArg w a (APt w b) natMul))) in let total : Nat := (Out SArg w b (APt w bump) (Out SArg w a (APt w base) natAdd)) in (Out SArg w b (APt w 100) (Out SArg w a (APt w total) natAdd))])
def main : Nat := (Out SArg w b (APt w (Out SArg w s (APt w (In SColl 2 (ALeg 1) [4])) pick)) (Out SArg w a (APt w (Out SArg w s (APt w (In SColl 2 (ALeg 0) [3])) pick)) natAdd))
