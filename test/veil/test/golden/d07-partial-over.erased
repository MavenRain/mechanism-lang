rec [nat]
fun add3 (union nat, union nat) : union nat := KTail (KGlobal natAdd) [KApp (KGlobal natAdd) [KVar 1; KVar 0]; KLit 3]
rec [fn<2>; nat]
fun later (func fn<2>, union nat, union nat) : union nat := KTail (KApp (KVar 2) [KVar 1]) [KVar 0]
rec [nat]
fun half (union nat) : union nat := KTail (KApp (KGlobal add3) [KLit 4]) [KVar 0]
rec [nat]
fun alias (union nat) : union nat := KTail (KApp (KGlobal natAdd) [KLit 1]) [KVar 0]
rec [nat]
fun main () : union nat := KTail (KGlobal natAdd) [KApp (KGlobal natAdd) [KApp (KGlobal half) [KLit 5]; KApp (KGlobal alias) [KLit 2]]; KApp (KGlobal later) [KGlobal natAdd; KLit 4; KLit 6]]
