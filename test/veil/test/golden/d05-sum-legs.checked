def Four : Type 1 := (Lan SColl 4 (Sec SColl 4 [ => ((Ran SColl 0 (Sec SColl 0 [])) : Type 1);  => ((Ran SColl 0 (Sec SColl 0 [])) : Type 1);  => Nat;  => Nat]))
def z0 : Four := (In SColl 4 (ALeg 0) [(Sec SColl 0 [])])
def z1 : Four := (In SColl 4 (ALeg 1) [(Sec SColl 0 [])])
def p2 : Four := (In SColl 4 (ALeg 2) [5])
def p3 : Four := (In SColl 4 (ALeg 3) [6])
def read : (Ran SPi w x Four Nat) := (Sec SPi w x Four [x => (Elim SColl 4 x with | (ALeg 0) u => 1 | (ALeg 1) v => 2 | (ALeg 2) a => (Out SArg w b (APt w 10) (Out SArg w a (APt w a) natAdd)) | (ALeg 3) b => (Out SArg w b (APt w 10) (Out SArg w a (APt w b) natMul)))])
def main : Nat := (Out SArg w b (APt w (Out SArg w b (APt w (Out SArg w x (APt w p3) read)) (Out SArg w a (APt w (Out SArg w x (APt w p2) read)) natAdd))) (Out SArg w a (APt w (Out SArg w b (APt w (Out SArg w x (APt w z1) read)) (Out SArg w a (APt w (Out SArg w x (APt w z0) read)) natAdd))) natAdd))
