def dbl : (Ran SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (Lan SMu N [] (Sec SColl 0 []))) := (Sec SPi w n (Lan SMu N [] (Sec SColl 0 [])) [n => (Elim SMu N [] n as x return (Lan SMu N [] (Sec SColl 0 [])) with | (ACtor zero)  => (In SMu N [] (ACtor zero) []) | (ACtor succ) m => (In SMu N [] (ACtor succ) [(In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w m) dbl)])]))])
def n0 : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(In SMu N [] (ACtor zero) [])])
def n1 : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w n0) dbl)])
def n2 : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w n1) dbl)])
def n3 : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w n2) dbl)])
def n4 : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w n3) dbl)])
def n5 : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w n4) dbl)])
def n6 : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w n5) dbl)])
def n7 : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w n6) dbl)])
def n8 : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w n7) dbl)])
def n9 : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w n8) dbl)])
def n10 : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w n9) dbl)])
def n11 : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w n10) dbl)])
def toNat : (Ran SPi w _ (Lan SMu N [] (Sec SColl 0 [])) Nat) := (Sec SPi w n (Lan SMu N [] (Sec SColl 0 [])) [n => (Elim SMu N [] n as x return Nat with | (ACtor zero)  => 0 | (ACtor succ) m => (Out SPi w b Nat (APt w (Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w m) toNat)) (Out SPi w a Nat (APt w 1) natAdd)))])
def main : Nat := (Out SPi w b Nat (APt w (Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w n11) toNat)) (Out SPi w a Nat (APt w 0) natAdd))
