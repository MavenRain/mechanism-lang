def add3 : (Ran SPi w a Nat (Ran SPi w b Nat Nat)) := (Sec SPi w a Nat [a => (Sec SPi w b Nat [b => (Out SArg w b (APt w 3) (Out SArg w a (APt w (Out SArg w b (APt w b) (Out SArg w a (APt w a) natAdd))) natAdd))])])
def later : (Ran SPi w f (Ran SPi w _ Nat (Ran SPi w _ Nat Nat)) (Ran SPi w x Nat (Ran SPi w _ Nat Nat))) := (Sec SPi w f (Ran SPi w _ Nat (Ran SPi w _ Nat Nat)) [f => (Sec SPi w x Nat [x => (Out SArg w _ (APt w x) f)])])
def half : (Ran SPi w _ Nat Nat) := (Out SArg w a (APt w 4) add3)
def alias : (Ran SPi w _ Nat Nat) := (Out SArg w a (APt w 1) natAdd)
def main : Nat := (Out SArg w b (APt w (Out SArg w _ (APt w 6) (Out SArg w x (APt w 4) (Out SArg w f (APt w natAdd) later)))) (Out SArg w a (APt w (Out SArg w b (APt w (Out SArg w _ (APt w 2) alias)) (Out SArg w a (APt w (Out SArg w _ (APt w 5) half)) natAdd))) natAdd))
