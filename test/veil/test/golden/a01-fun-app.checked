axiom Nat : Type 1
def id : (Ran SPi 0 A Type 1 (Ran SPi w x A A)) := (Sec SPi 0 A Type 1 [A => (Sec SPi w x A [x => x])])
def twice : (Ran SPi 0 A Type 1 (Ran SPi w f (Ran SPi w y A A) (Ran SPi w x A A))) := (Sec SPi 0 A Type 1 [A => (Sec SPi w f (Ran SPi w y A A) [f => (Sec SPi w x A [x => (Out SArg w y (APt w (Out SArg w y (APt w x) f)) f)])])])
def idNat : (Ran SPi w x Nat Nat) := (Out SArg 0 A (APt 0 Nat) id)
