def sizeA : (Ran SPi w _ (Lan SMu A [] (Sec SColl 0 [])) (Lan SMu N [] (Sec SColl 0 []))) := (Sec SPi w a (Lan SMu A [] (Sec SColl 0 [])) [a => (Elim SMu A [] a as x return (Lan SMu N [] (Sec SColl 0 [])) with | (ACtor leaf)  => (In SMu N [] (ACtor zero) []) | (ACtor node) b => (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu B [] (Sec SColl 0 [])) (APt w b) sizeB)]))])
def sizeB : (Ran SPi w _ (Lan SMu B [] (Sec SColl 0 [])) (Lan SMu N [] (Sec SColl 0 []))) := (Sec SPi w b (Lan SMu B [] (Sec SColl 0 [])) [b => (Elim SMu B [] b as x return (Lan SMu N [] (Sec SColl 0 [])) with | (ACtor cons) a => (In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu A [] (Sec SColl 0 [])) (APt w a) sizeA)]))])
def toNat : (Ran SPi w _ (Lan SMu N [] (Sec SColl 0 [])) Nat) := (Sec SPi w n (Lan SMu N [] (Sec SColl 0 [])) [n => (Elim SMu N [] n as x return Nat with | (ACtor zero)  => 0 | (ACtor succ) m => (Out SPi w b Nat (APt w (Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w m) toNat)) (Out SPi w a Nat (APt w 1) natAdd)))])
def main : Nat := (Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w (Out SPi w _ (Lan SMu A [] (Sec SColl 0 [])) (APt w (In SMu A [] (ACtor node) [(In SMu B [] (ACtor cons) [(In SMu A [] (ACtor node) [(In SMu B [] (ACtor cons) [(In SMu A [] (ACtor leaf) [])])])])])) sizeA)) toNat)
