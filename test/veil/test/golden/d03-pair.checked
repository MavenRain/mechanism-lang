def p : (Lan SPi w a Nat Nat) := (In SPi w a Nat (APt w 11) [6])
def mk : (Ran SPi w x Nat (Lan SPi w a Nat Nat)) := (Sec SPi w x Nat [x => (In SPi w a Nat (APt w x) [(Out SArg w b (APt w 1) (Out SArg w a (APt w x) natAdd))])])
def q : (Lan SPi w a Nat Nat) := (Out SArg w x (APt w 4) mk)
def main : Nat := (Out SArg w b (APt w (Out SArg w b (APt w (Elim SPi w a Nat q as self return Nat with | (ALeg 0) x y => y)) (Out SArg w a (APt w (Elim SPi w a Nat q as self return Nat with | (ALeg 0) x y => x)) natAdd))) (Out SArg w a (APt w (Out SArg w b (APt w (Elim SPi w a Nat p as self return Nat with | (ALeg 0) x y => y)) (Out SArg w a (APt w (Elim SPi w a Nat p as self return Nat with | (ALeg 0) x y => x)) natAdd))) natAdd))
