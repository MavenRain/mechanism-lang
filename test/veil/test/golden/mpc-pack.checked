def Bool : Type 1 := (Lan SColl 2 (Sec SColl 2 [ => ((Ran SColl 0 (Sec SColl 0 [])) : Type 1);  => ((Ran SColl 0 (Sec SColl 0 [])) : Type 1)]))
def isTrue : (Ran SPi w b Bool Type 0) := (Sec SPi w b Bool [b => (Elim SColl 2 b as z return Type 0 with | (ALeg 0) x => (Lan SColl 0 (Sec SColl 0 [])) | (ALeg 1) y => (Ran SColl 0 (Sec SColl 0 [])))])
def Party : Type 0 := (Lan SColl 2 (Sec SColl 2 [ => (Ran SColl 0 (Sec SColl 0 []));  => (Ran SColl 0 (Sec SColl 0 []))]))
def alice : Party := (In SColl 2 (ALeg 0) [(Sec SColl 0 [])])
def bob : Party := (In SColl 2 (ALeg 1) [(Sec SColl 0 [])])
def allParties : (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat])) := (Sec SColl 2 [ => 1;  => 1])
def both : (Ran SPi 0 q (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat])) Type 0) := (Sec SPi 0 q (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat])) [q => (Out SArg w b (APt w (Out SArg w b (APt w 2) (Out SArg w a (APt w (Out SArg w b (APt w (Out SColl 2 (ALeg 1) q)) (Out SArg w a (APt w (Out SColl 2 (ALeg 0) q)) natAdd))) natEq))) isTrue)])
axiom secretA : Nat
axiom secretB : Nat
def jointSum : (Ran SPi 1 a Nat (Ran SPi 1 b Nat (Ran SMpc (Party, both) Nat))) := (Sec SPi 1 a Nat [a => (Sec SPi 1 b Nat [b => (Sec SMpc (Party, both) [ => allParties;  => (natAdd : (Ran SPi w x Nat (Ran SPi w y Nat Nat)));  => ((Sec SMpc (Party, both) [ => alice;  => a]) : (Ran SMpc (Party, both) Nat));  => ((Sec SMpc (Party, both) [ => bob;  => b]) : (Ran SMpc (Party, both) Nat))])])])
def joint : (Ran SMpc (Party, both) Nat) := (Out SArg 1 b (APt 1 secretB) (Out SArg 1 a (APt 1 secretA) jointSum))
def reveal : (Ran SPi 0 h (Out SArg 0 q (APt 0 allParties) both) (Ran SPi 1 c (Ran SMpc (Party, both) Nat) Nat)) := (Sec SPi 0 h (Out SArg 0 q (APt 0 allParties) both) [h => (Sec SPi 1 c (Ran SMpc (Party, both) Nat) [c => (Out SMpc (Party, both) (APt 0 (In SPi 0 q (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat])) (APt 0 allParties) [h])) c)])])
def opened : Nat := (Out SArg 1 c (APt 1 joint) (Out SArg 0 h (APt 0 (Sec SColl 0 [])) reveal))
