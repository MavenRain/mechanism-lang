axiom F : (Ran SPi 0 n Nat Type 0)
axiom v : (Out SArg 0 n (APt 0 6) F)
def w : (Out SArg 0 n (APt 0 (Out SArg w b (APt w 3) (Out SArg w a (APt w 2) natMul))) F) := v
def Bool : Type 1 := (Lan SColl 2 (Sec SColl 2 [ => ((Ran SColl 0 (Sec SColl 0 [])) : Type 1);  => ((Ran SColl 0 (Sec SColl 0 [])) : Type 1)]))
def same : Bool := (Out SArg w b (APt w 4) (Out SArg w a (APt w 4) natEq))
def below : Bool := (Out SArg w b (APt w 2) (Out SArg w a (APt w 1) natLt))
def sum6 : Nat := (Out SArg w b (APt w 2) (Out SArg w a (APt w 4) natAdd))
