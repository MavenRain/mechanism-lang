def sq : (Ran SPi w x Nat Nat) := (Sec SPi w x Nat [x => (Out SArg w b (APt w x) (Out SArg w a (APt w x) natMul))])
def sqz : (Ran SPi 0 t Type 1 (Ran SPi w x Nat Nat)) := (Sec SPi 0 t Type 1 [t => (Sec SPi w x Nat [x => x])])
def app : (Ran SPi w f (Ran SPi w n Nat Nat) (Ran SPi w x Nat Nat)) := (Sec SPi w f (Ran SPi w n Nat Nat) [f => (Sec SPi w x Nat [x => (Out SArg w n (APt w x) f)])])
