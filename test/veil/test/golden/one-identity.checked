def identity : (Ran SPi 1 x Nat Nat) := (Sec SPi 1 x Nat [x => x])
def through : (Ran SPi 1 x Nat Nat) := (Sec SPi 1 x Nat [x => (Out SArg 1 x (APt 1 x) identity)])
def alias : (Ran SPi 1 x Nat Nat) := (Sec SPi 1 x Nat [x => let y : Nat := x in y])
def discardAlias : (Ran SPi 1 x Nat Nat) := (Sec SPi 1 x Nat [x => let y : Nat := x in 0])
def ghost : (Ran SPi 0 x Nat Nat) := (Sec SPi 0 x Nat [x => 0])
def erasedThenOnce : (Ran SPi 1 x Nat Nat) := (Sec SPi 1 x Nat [x => let y : Nat := (Out SArg 0 x (APt 0 x) ghost) in x])
def main : Nat := (Out SArg 1 x (APt 1 7) through)
