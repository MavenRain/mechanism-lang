def id : (Ran SPi 0 A Type 1 (Ran SPi w x A A)) := (Sec SPi 0 A Type 1 [A => (Sec SPi w x A [x => x])])
def idNat : (Ran SPi w x Nat Nat) := (Out SPi 0 A Type 1 (APt 0 Nat) id)
def main : Nat := (Out SPi w b Nat (APt w (Out SPi w x Nat (APt w 4) idNat)) (Out SPi w a Nat (APt w (Out SPi w x Nat (APt w 3) (Out SPi 0 A Type 1 (APt 0 Nat) id))) natAdd))
