def Bool : Type 1 := (Lan SColl 2 (Sec SColl 2 [ => ((Ran SColl 0 (Sec SColl 0 [])) : Type 1);  => ((Ran SColl 0 (Sec SColl 0 [])) : Type 1)]))
def total : Nat := (Out SArg w b (APt w 3) (Out SArg w a (APt w 2) natAdd))
def diff : Nat := (Out SArg w b (APt w 1) (Out SArg w a (APt w 5) natSub))
def product : Nat := (Out SArg w b (APt w 7) (Out SArg w a (APt w 6) natMul))
def same : Bool := (Out SArg w b (APt w 4) (Out SArg w a (APt w 4) natEq))
def less : Bool := (Out SArg w b (APt w 2) (Out SArg w a (APt w 1) natLt))
def mixed : Nat := (Out SArg w b (APt w 4) (Out SArg w a (APt w (Out SArg w b (APt w 3) (Out SArg w a (APt w 2) natMul))) natAdd))
