def id : (Ran SPi 0 A Type 1 (Ran SPi w x A A)) := (Sec SPi 0 A Type 1 [A => (Sec SPi w x A [x => x])])
def mk : (Ran SPi w x Nat (Lan SPi w f (Ran SPi w _ Nat Nat) Nat)) := (Sec SPi w x Nat [x => let z : Nat := (Out SArg w x (APt w x) (Out SArg 0 A (APt 0 Nat) id)) in (In SPi w f (Ran SPi w _ Nat Nat) (APt w (Sec SPi w y Nat [y => (Out SArg w b (APt w y) (Out SArg w a (APt w z) natAdd))])) [z])])
def main : Nat := (Out SArg w _ (APt w 6) (Elim SPi w f (Ran SPi w _ Nat Nat) (Out SArg w x (APt w 5) mk) as self return (Ran SPi w _ Nat Nat) with | (ALeg 0) x y => x))
