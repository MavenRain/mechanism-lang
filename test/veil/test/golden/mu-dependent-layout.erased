rec [mu<Pack>; leg<mu<Pack>,0,union any,union nat>]
fun pn () : union mu<Pack> := KTag mu<Pack> 0 [KLit 7; KLit 8]
rec [mu<Pack>; leg<mu<Pack>,0,union any,union nat>]
fun pu () : union mu<Pack> := KTag mu<Pack> 0 [KErased; KLit 9]
rec [nat; mu<Pack>; leg<mu<Pack>,0,union any,union nat>]
fun pf$0 (union nat) : union nat := KTail (KGlobal natAdd) [KVar 0; KLit 1]
fun pf () : union mu<Pack> := KTag mu<Pack> 0 [KClos pf$0 1 []; KLit 10]
rec [mu<Pack>; nat; leg<mu<Pack>,0,union any,union nat>]
fun last (union mu<Pack>) : union nat := KCase mu<Pack> (KVar 0) [{0 2 (KVar 0)}]
rec [nat]
fun main () : union nat := KTail (KGlobal natAdd) [KApp (KGlobal last) [KGlobal pn]; KApp (KGlobal natAdd) [KApp (KGlobal last) [KGlobal pu]; KApp (KGlobal last) [KGlobal pf]]]
