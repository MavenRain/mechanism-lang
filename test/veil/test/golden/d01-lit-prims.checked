def Bool : Type 1 := (Lan SColl 2 (Sec SColl 2 [ => ((Ran SColl 0 (Sec SColl 0 [])) : Type 1);  => ((Ran SColl 0 (Sec SColl 0 [])) : Type 1)]))
def toNat : (Ran SPi w b Bool Nat) := (Sec SPi w b Bool [b => (Elim SColl 2 b with | (ALeg 0) x => 0 | (ALeg 1) y => 1)])
def scaled : Nat := (Out SArg w b (APt w (Out SArg w b (APt w 4) (Out SArg w a (APt w 7) natSub))) (Out SArg w a (APt w (Out SArg w b (APt w 3) (Out SArg w a (APt w 2) natAdd))) natMul))
def flags : Nat := (Out SArg w b (APt w (Out SArg w b (APt w (Out SArg w b (APt w 2) (Out SArg w a (APt w 1) natLt))) toNat)) (Out SArg w a (APt w (Out SArg w b (APt w (Out SArg w b (APt w 4) (Out SArg w a (APt w 4) natEq))) toNat)) natAdd))
def main : Nat := (Out SArg w b (APt w flags) (Out SArg w a (APt w scaled) natAdd))
