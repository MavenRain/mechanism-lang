def step : (Ran SPi w a Nat (Ran SPi w b Nat Nat)) := (Sec SPi w a Nat [a => (Sec SPi w b Nat [b => (Out SArg w b (APt w b) (Out SArg w a (APt w a) natAdd))])])
def chain : (Ran SPi w a Nat (Ran SPi w b Nat Nat)) := (Sec SPi w a Nat [a => (Sec SPi w b Nat [b => (Out SArg w b (APt w b) (Out SArg w a (APt w (Out SArg w b (APt w 1) (Out SArg w a (APt w a) natAdd))) step))])])
def outer : (Ran SPi w a Nat (Ran SPi w b Nat Nat)) := (Sec SPi w a Nat [a => (Sec SPi w b Nat [b => (Out SArg w b (APt w b) (Out SArg w a (APt w (Out SArg w b (APt w 2) (Out SArg w a (APt w a) natAdd))) chain))])])
def main : Nat := (Out SArg w b (APt w 4) (Out SArg w a (APt w 3) outer))
