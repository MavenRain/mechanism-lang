def read_index : Type 1 := let d : (Lan SMu V [(In SMu N [] (ACtor zero) [])] (Sec SColl 0 [])) := (Elim SMu V [(In SMu N [] (ACtor zero) [])] ((In SMu V [(In SMu N [] (ACtor zero) [])] (ACtor vz) []) : (Lan SMu V [(In SMu N [] (ACtor zero) [])] (Sec SColl 0 []))) as x return (Lan SMu V [i] (Sec SColl 0 [])) with | (ACtor vz)  => (In SMu V [(In SMu N [] (ACtor zero) [])] (ACtor vz) []) | (ACtor vs) j w => (In SMu V [(In SMu N [] (ACtor succ) [j])] (ACtor vs) [j; w])) in Nat
