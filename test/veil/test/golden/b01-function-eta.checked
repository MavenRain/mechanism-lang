axiom A : Type 1
axiom f : (Ran SPi w _ A A)
axiom F : (Ran SPi 0 g (Ran SPi w _ A A) Type 0)
axiom w : (Out SArg 0 g (APt 0 f) F)
axiom H : (Ran SPi 0 g (Ran SPi w _ A A) Type 0)
axiom v : (Out SArg 0 g (APt 0 (Sec SPi w x A [x => (Out SArg w _ (APt w x) f)])) H)
def etaExpanded : (Out SArg 0 g (APt 0 (Sec SPi w x A [x => (Out SArg w _ (APt w x) f)])) F) := w
def etaContracted : (Out SArg 0 g (APt 0 f) H) := v
