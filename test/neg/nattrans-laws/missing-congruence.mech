def bad : (0 C : Type 0) -> (0 D : Type 2) ->
    (c : Mixed_Ops_Base_Source_Category C) -> (d : Mixed_Ops_Base_Target_Category D) ->
    (F : Mixed_Ops_Base_Functor C D c d) -> (G : Mixed_Ops_Base_Functor C D c d) ->
    (H : Mixed_Ops_Base_Functor C D c d) ->
    (alpha : Mixed_Ops_NatTrans C D c d F G) -> (alpha2 : Mixed_Ops_NatTrans C D c d F G) ->
    (beta : Mixed_Ops_NatTrans C D c d G H) -> (beta2 : Mixed_Ops_NatTrans C D c d G H) ->
    Mixed_NatTransEq C D c d F G alpha alpha2 -> Mixed_NatTransEq C D c d F H
      (Mixed_Ops_vcomp C D c d F G H alpha beta) (Mixed_Ops_vcomp C D c d F G H alpha2 beta2) :=
  fun (0 C : Type 0) (0 D : Type 2)
      (c : Mixed_Ops_Base_Source_Category C) (d : Mixed_Ops_Base_Target_Category D)
      (F : Mixed_Ops_Base_Functor C D c d) (G : Mixed_Ops_Base_Functor C D c d)
      (H : Mixed_Ops_Base_Functor C D c d)
      (alpha : Mixed_Ops_NatTrans C D c d F G) (alpha2 : Mixed_Ops_NatTrans C D c d F G)
      (beta : Mixed_Ops_NatTrans C D c d G H) (beta2 : Mixed_Ops_NatTrans C D c d G H)
      (first : Mixed_NatTransEq C D c d F G alpha alpha2) =>
    Mixed_vcompCongr C D c d F G H alpha alpha2 beta beta2 first
