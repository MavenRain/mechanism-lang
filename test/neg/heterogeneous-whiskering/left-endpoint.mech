def bad : (0 CLeft : Type 0) -> (0 D : Type 2) -> (0 E : Type 4) ->
    (c : Mixed_Base_Source_Category CLeft) -> (d : Mixed_Base_Middle_Category D) ->
    (e : Mixed_Base_Target_Category E) ->
    (H : Mixed_Base_Second_Functor D E d e) ->
    (F : Mixed_Base_First_Functor CLeft D c d) -> (G : Mixed_Base_First_Functor CLeft D c d) ->
    Mixed_First_NatTrans CLeft D c d F G ->
    Mixed_Composite_NatTrans CLeft E c e
      (Mixed_Base_compFunctor CLeft D E c d e F H) (Mixed_Base_compFunctor CLeft D E c d e F H) :=
  fun (0 CLeft : Type 0) (0 D : Type 2) (0 E : Type 4)
      (c : Mixed_Base_Source_Category CLeft) (d : Mixed_Base_Middle_Category D)
      (e : Mixed_Base_Target_Category E)
      (H : Mixed_Base_Second_Functor D E d e)
      (F : Mixed_Base_First_Functor CLeft D c d) (G : Mixed_Base_First_Functor CLeft D c d)
      (alpha : Mixed_First_NatTrans CLeft D c d F G) =>
    Mixed_whiskerLeft CLeft D E c d e H F G alpha
