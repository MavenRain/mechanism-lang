def bad : (0 C : Type 0) -> (0 D : Type 2) -> (0 E : Type 4) ->
    (c : Mixed_Base_Source_Category C) -> (d : Mixed_Base_Middle_Category D) ->
    (other : Mixed_Base_Middle_Category D) -> (e : Mixed_Base_Target_Category E) ->
    (H : Mixed_Base_Second_Functor D E other e) ->
    (goodH : Mixed_Base_Second_Functor D E d e) ->
    (F : Mixed_Base_First_Functor C D c d) -> (G : Mixed_Base_First_Functor C D c d) ->
    Mixed_First_NatTrans C D c d F G ->
    Mixed_Composite_NatTrans C E c e
      (Mixed_Base_compFunctor C D E c d e F goodH) (Mixed_Base_compFunctor C D E c d e G goodH) :=
  fun (0 C : Type 0) (0 D : Type 2) (0 E : Type 4)
      (c : Mixed_Base_Source_Category C) (d : Mixed_Base_Middle_Category D)
      (other : Mixed_Base_Middle_Category D) (e : Mixed_Base_Target_Category E)
      (H : Mixed_Base_Second_Functor D E other e)
      (goodH : Mixed_Base_Second_Functor D E d e)
      (F : Mixed_Base_First_Functor C D c d) (G : Mixed_Base_First_Functor C D c d)
      (alpha : Mixed_First_NatTrans C D c d F G) =>
    Mixed_whiskerLeft C D E c d e H F G alpha
