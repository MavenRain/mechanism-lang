def incompatibleEndpoints : (0 C : Type 0) -> (0 D : Type 2) ->
    (c : UnitsMixed_Source_Category C) -> (d : UnitsMixed_Target_Category D) ->
    (F : UnitsMixed_After_First_Base_Functor C D c d) ->
    (G : UnitsMixed_After_First_Base_Functor C D c d) ->
    (alpha : UnitsMixed_After_First_NatTrans C D c d G F) -> (x : C) ->
    UnitsMixed_Target (UnitsMixed_Target_Hom D d (G.1 x) (F.1 x)) (alpha.1 x) (alpha.1 x) :=
  fun (0 C : Type 0) (0 D : Type 2)
      (c : UnitsMixed_Source_Category C) (d : UnitsMixed_Target_Category D)
      (F : UnitsMixed_After_First_Base_Functor C D c d)
      (G : UnitsMixed_After_First_Base_Functor C D c d)
      (alpha : UnitsMixed_After_First_NatTrans C D c d G F) (x : C) =>
    UnitsMixed_whiskerLeftIdFunctor C D c d F G alpha x
