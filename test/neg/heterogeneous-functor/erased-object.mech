def bad : (0 C : Type 0) -> (0 D : Type 2) ->
    (c : Mixed_Source_Category C) -> (d : Mixed_Target_Category D) ->
    Mixed_Functor C D c d -> (0 x : C) -> D :=
  fun (0 C : Type 0) (0 D : Type 2) (c : Mixed_Source_Category C)
      (d : Mixed_Target_Category D) (F : Mixed_Functor C D c d) (0 x : C) => F.1 x
