def reversedUnit : (0 J : Type 0) -> (0 C : Type 0) -> (0 D : Type 0) ->
    (j : Small_Category J) -> (c : Small_Category C) -> (d : Small_Category D) ->
    (K : Small_Functor J C j c) -> (F : Small_Functor J D j d) ->
    (H : Small_Functor C D c d) ->
    (eta : Small_LanCocone J C D j c d K F H) -> (x : J) ->
    Small_Hom D d (H.1 (K.1 x)) (F.1 x) :=
  fun (0 J : Type 0) (0 C : Type 0) (0 D : Type 0)
      (j : Small_Category J) (c : Small_Category C) (d : Small_Category D)
      (K : Small_Functor J C j c) (F : Small_Functor J D j d)
      (H : Small_Functor C D c d)
      (eta : Small_LanCocone J C D j c d K F H) (x : J) => eta.1 x
