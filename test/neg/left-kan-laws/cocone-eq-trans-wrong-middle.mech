def badCoconeEqTransMiddle : (0 J : Type 2) -> (0 C : Type 1) -> (0 D : Type 0) ->
    (j : Wide_Base_Base_Source_Category J) -> (c : Wide_Base_Base_Middle_Category C) ->
    (d : Wide_Base_Base_Target_Category D) ->
    (K : Wide_Base_Base_First_Base_Functor J C j c) ->
    (F : Wide_Base_Base_Composite_Base_Functor J D j d) ->
    (G : Wide_Base_Base_Second_Base_Functor C D c d) ->
    (alpha : Wide_Base_Lan_LanCocone J C D j c d K F G) ->
    (beta : Wide_Base_Lan_LanCocone J C D j c d K F G) ->
    (gamma : Wide_Base_Lan_LanCocone J C D j c d K F G) ->
    (delta : Wide_Base_Lan_LanCocone J C D j c d K F G) ->
    Wide_CoconeEq J C D j c d K F G alpha beta ->
    Wide_CoconeEq J C D j c d K F G gamma delta ->
    Wide_CoconeEq J C D j c d K F G alpha delta :=
  fun (0 J : Type 2) (0 C : Type 1) (0 D : Type 0)
      (j : Wide_Base_Base_Source_Category J) (c : Wide_Base_Base_Middle_Category C)
      (d : Wide_Base_Base_Target_Category D)
      (K : Wide_Base_Base_First_Base_Functor J C j c)
      (F : Wide_Base_Base_Composite_Base_Functor J D j d)
      (G : Wide_Base_Base_Second_Base_Functor C D c d)
      (alpha : Wide_Base_Lan_LanCocone J C D j c d K F G)
      (beta : Wide_Base_Lan_LanCocone J C D j c d K F G)
      (gamma : Wide_Base_Lan_LanCocone J C D j c d K F G)
      (delta : Wide_Base_Lan_LanCocone J C D j c d K F G)
      (first : Wide_CoconeEq J C D j c d K F G alpha beta)
      (second : Wide_CoconeEq J C D j c d K F G gamma delta) =>
    Wide_coconeEqTrans J C D j c d K F G alpha beta delta first second
