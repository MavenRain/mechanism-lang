def bad : (0 C : Type 0) -> (0 D : Type 2) ->
    (c : Mixed_Source_Category C) -> (d : Mixed_Middle_Category D) ->
    (F : Mixed_First_Base_Functor C D c d) -> (G : Mixed_First_Base_Functor C D c d) ->
    (H : Mixed_First_Base_Functor C D c d) ->
    Mixed_First_NatTrans C D c d F G -> Mixed_First_NatTrans C D c d F H ->
    Mixed_First_NatTrans C D c d F H :=
  fun (0 C : Type 0) (0 D : Type 2) (c : Mixed_Source_Category C) (d : Mixed_Middle_Category D)
      (F : Mixed_First_Base_Functor C D c d) (G : Mixed_First_Base_Functor C D c d)
      (H : Mixed_First_Base_Functor C D c d) (alpha : Mixed_First_NatTrans C D c d F G)
      (beta : Mixed_First_NatTrans C D c d F H) =>
    Mixed_First_vcomp C D c d F G H alpha beta
