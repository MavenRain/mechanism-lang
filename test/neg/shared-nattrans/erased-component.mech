def bad : (0 C : Type 0) -> (0 D : Type 2) ->
    (c : Mixed_Source_Category C) -> (d : Mixed_Middle_Category D) ->
    (F : Mixed_First_Base_Functor C D c d) -> (G : Mixed_First_Base_Functor C D c d) ->
    Mixed_First_NatTrans C D c d F G -> (0 x : C) -> Mixed_Middle_Hom D d (F.1 x) (G.1 x) :=
  fun (0 C : Type 0) (0 D : Type 2) (c : Mixed_Source_Category C)
      (d : Mixed_Middle_Category D) (F : Mixed_First_Base_Functor C D c d)
      (G : Mixed_First_Base_Functor C D c d)
      (alpha : Mixed_First_NatTrans C D c d F G) (0 x : C) =>
    Mixed_First_natApp C D c d F G alpha x
