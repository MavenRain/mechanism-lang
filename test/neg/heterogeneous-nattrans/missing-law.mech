def bad : (0 C : Type 0) -> (0 D : Type 2) ->
    (c : Mixed_Base_Source_Category C) -> (d : Mixed_Base_Target_Category D) ->
    (F : Mixed_Base_Functor C D c d) -> (G : Mixed_Base_Functor C D c d) ->
    ((x : C) -> Mixed_Base_Target_Hom D d (F.1 x) (G.1 x)) -> Mixed_NatTrans C D c d F G :=
  fun (0 C : Type 0) (0 D : Type 2) (c : Mixed_Base_Source_Category C)
      (d : Mixed_Base_Target_Category D) (F : Mixed_Base_Functor C D c d)
      (G : Mixed_Base_Functor C D c d)
      (app : (x : C) -> Mixed_Base_Target_Hom D d (F.1 x) (G.1 x)) =>
    (app, (fun (0 x : C) (0 y : C) (f : Mixed_Base_Source_Hom C c x y) => 0))
