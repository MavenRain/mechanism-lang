-- Use the existing checked category port for the allocation-to-host map.
specialize MechCategory (1, 0) as Gpu
def gpuFunctions : Gpu_Category (Type 0) :=
  ((fun (0 A : Type 0) (0 B : Type 0) => A -> B),
   ((fun (0 A : Type 0) (a : A) => a),
    ((fun (0 A : Type 0) (0 B : Type 0) (0 C : Type 0)
          (f : A -> B) (g : B -> C) (a : A) => g (f a)),
     ((fun (0 A : Type 0) (0 B : Type 0) (0 f : A -> B) => categoryRefl),
      ((fun (0 A : Type 0) (0 B : Type 0) (0 f : A -> B) => categoryRefl),
       (fun (0 A : Type 0) (0 B : Type 0) (0 C : Type 0) (0 D : Type 0)
            (0 f : A -> B) (0 g : B -> C) (0 h : C -> D) => categoryRefl))))))
def gpuAllocationMap : AuctionChoice -> Nat :=
  gpuFunctions.2.2.1 AuctionChoice Nat Nat auctionBit (gpuFunctions.2.1 Nat)
def gpuCategoryWinChecked : MechEq Nat (gpuAllocationMap auctionWin) 1 := mechRefl Nat 1
def gpuCategoryLoseChecked : MechEq Nat (gpuAllocationMap auctionLose) 0 := mechRefl Nat 0
