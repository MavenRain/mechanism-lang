{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Combinatorial GPU auction v1",
  "description": "Structural schema. The CLI also checks references, unique IDs, total value, time bounds, and inventory admission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "auction_id", "inventory", "tenants"],
  "properties": {
    "version": {"const": 1},
    "auction_id": {"$ref": "#/$defs/id"},
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["horizon", "tick_seconds", "hosts", "slices"],
      "properties": {
        "horizon": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "tick_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "hosts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "cpu_cores"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "cpu_cores": {"type": "integer", "minimum": 1, "maximum": 65536}}
        }},
        "slices": {"type": "array", "minItems": 1, "maxItems": 256, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "host", "profile", "hbm_mib"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "host": {"$ref": "#/$defs/id"},
            "profile": {"$ref": "#/$defs/id"}, "hbm_mib": {"$ref": "#/$defs/hbm"}}
        }}
      }
    },
    "tenants": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "offers"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "offers": {"type": "array", "maxItems": 128, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "value", "bundle"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "value": {"type": "integer", "minimum": 0, "maximum": 1125899906842623},
            "bundle": {"$ref": "#/$defs/bundle"}
          }
        }}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "hbm": {"type": "integer", "minimum": 1, "maximum": 1073741824},
    "bundle": {
      "type": "object", "additionalProperties": false, "required": ["start", "duration", "slices", "cpu_cores"],
      "properties": {
        "start": {"type": "integer", "minimum": 0, "maximum": 999999999},
        "duration": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "slices": {"type": "array", "minItems": 1, "maxItems": 256, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "hbm_mib"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "hbm_mib": {"$ref": "#/$defs/hbm"}}
        }},
        "cpu_cores": {"type": "object", "minProperties": 1, "maxProperties": 64,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 65536}}
      }
    }
  }
}
