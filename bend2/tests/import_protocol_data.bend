import Base

# Inputs from original test/import.ml; assertions execute Export APIs directly.
type Probe is Data:
  Accept{}
  Reject{line:U32}
  Numeric{}
  Group{}
  Dotted{}

type Case is Data:
  Case{name:String,source:String,probe:Probe}

def base() -> String:
  "{\"meta\":{\"exporter\":{\"name\":\"lean4export\",\"version\":\"3.1.0\"},\"format\":{\"version\":\"3.1.0\"},\"lean\":{\"githash\":\"fixture\",\"version\":\"4.31.0\"}}}\n{\"in\":1,\"str\":{\"pre\":0,\"str\":\"D\"}}\n{\"in\":2,\"str\":{\"pre\":0,\"str\":\"u\"}}\n{\"in\":3,\"str\":{\"pre\":0,\"str\":\"C\"}}\n{\"in\":4,\"str\":{\"pre\":0,\"str\":\"R\"}}\n{\"in\":5,\"str\":{\"pre\":0,\"str\":\"T\"}}\n{\"il\":1,\"succ\":0}\n{\"ie\":0,\"sort\":0}\n{\"ie\":1,\"bvar\":0}\n{\"ie\":2,\"sort\":1}\n"

