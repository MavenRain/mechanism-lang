def values() -> List<&2, C.Pair<String, T.T>>:
  [C.Pair{"whiskerRightFirst", R.natural(42)}, C.Pair{"whiskerRightSecond", R.natural(44)}, C.Pair{"whiskerLeftFirst", R.natural(46)}, C.Pair{"whiskerLeftSecond", R.natural(48)}]

def suite(+root: String) -> R.Task(String):
  do R.Task<String>:
    canonical : String <- R.read(root, "prelude/cat/heterogeneous-nattrans.mech")
    +target : String <- R.read(root, "prelude/cat/heterogeneous-whiskering.mech")
    +body : String = Text.member_body(canonical, "def NatTrans ", "def idNat ")
    ok : Unit <- R.assert(Nat.is_gt(String.length(body), 1n), "missing canonical natural transformation members")
    ok : Unit <- R.assert(String.contains(target, Text.rename_words(body, [C.Pair{"u", "u"}, C.Pair{"v", "v"}, C.Pair{"w", "w"}, C.Pair{"z", "z"}], [C.Pair{"NatTrans", "First_NatTrans"}, C.Pair{"natApp", "First_natApp"}, C.Pair{"naturality", "First_naturality"}, C.Pair{"Base_Functor", "Base_First_Functor"}, C.Pair{"Base_functorObj", "Base_First_functorObj"}, C.Pair{"Base_functorMap", "Base_First_functorMap"}, C.Pair{"Base_functorMapId", "Base_First_functorMapId"}, C.Pair{"Base_functorMapComp", "Base_First_functorMapComp"}, C.Pair{"Base_eqCongr", "Base_First_eqCongr"}, C.Pair{"Base_Source", "Base_Source"}, C.Pair{"Base_Source_Category", "Base_Source_Category"}, C.Pair{"Base_Source_Hom", "Base_Source_Hom"}, C.Pair{"Base_Source_id", "Base_Source_id"}, C.Pair{"Base_Source_comp", "Base_Source_comp"}, C.Pair{"Base_Source_idComp", "Base_Source_idComp"}, C.Pair{"Base_Source_compId", "Base_Source_compId"}, C.Pair{"Base_Source_assoc", "Base_Source_assoc"}, C.Pair{"Base_Source_eqTrans", "Base_Source_eqTrans"}, C.Pair{"Base_Source_eqCongr", "Base_Source_eqCongr"}, C.Pair{"Base_Target", "Base_Middle"}, C.Pair{"Base_Target_Category", "Base_Middle_Category"}, C.Pair{"Base_Target_Hom", "Base_Middle_Hom"}, C.Pair{"Base_Target_id", "Base_Middle_id"}, C.Pair{"Base_Target_comp", "Base_Middle_comp"}, C.Pair{"Base_Target_idComp", "Base_Middle_idComp"}, C.Pair{"Base_Target_compId", "Base_Middle_compId"}, C.Pair{"Base_Target_assoc", "Base_Middle_assoc"}, C.Pair{"Base_Target_eqTrans", "Base_Middle_eqTrans"}, C.Pair{"Base_Target_eqCongr", "Base_Middle_eqCongr"}])), "natural transformation mirror changed: First")
    ok : Unit <- R.assert(String.contains(target, Text.rename_words(body, [C.Pair{"u", "w"}, C.Pair{"v", "z"}, C.Pair{"w", "p"}, C.Pair{"z", "q"}], [C.Pair{"NatTrans", "Second_NatTrans"}, C.Pair{"natApp", "Second_natApp"}, C.Pair{"naturality", "Second_naturality"}, C.Pair{"Base_Functor", "Base_Second_Functor"}, C.Pair{"Base_functorObj", "Base_Second_functorObj"}, C.Pair{"Base_functorMap", "Base_Second_functorMap"}, C.Pair{"Base_functorMapId", "Base_Second_functorMapId"}, C.Pair{"Base_functorMapComp", "Base_Second_functorMapComp"}, C.Pair{"Base_eqCongr", "Base_Second_eqCongr"}, C.Pair{"Base_Source", "Base_Middle"}, C.Pair{"Base_Source_Category", "Base_Middle_Category"}, C.Pair{"Base_Source_Hom", "Base_Middle_Hom"}, C.Pair{"Base_Source_id", "Base_Middle_id"}, C.Pair{"Base_Source_comp", "Base_Middle_comp"}, C.Pair{"Base_Source_idComp", "Base_Middle_idComp"}, C.Pair{"Base_Source_compId", "Base_Middle_compId"}, C.Pair{"Base_Source_assoc", "Base_Middle_assoc"}, C.Pair{"Base_Source_eqTrans", "Base_Middle_eqTrans"}, C.Pair{"Base_Source_eqCongr", "Base_Middle_eqCongr"}, C.Pair{"Base_Target", "Base_Target"}, C.Pair{"Base_Target_Category", "Base_Target_Category"}, C.Pair{"Base_Target_Hom", "Base_Target_Hom"}, C.Pair{"Base_Target_id", "Base_Target_id"}, C.Pair{"Base_Target_comp", "Base_Target_comp"}, C.Pair{"Base_Target_idComp", "Base_Target_idComp"}, C.Pair{"Base_Target_compId", "Base_Target_compId"}, C.Pair{"Base_Target_assoc", "Base_Target_assoc"}, C.Pair{"Base_Target_eqTrans", "Base_Target_eqTrans"}, C.Pair{"Base_Target_eqCongr", "Base_Target_eqCongr"}])), "natural transformation mirror changed: Second")
    ok : Unit <- R.assert(String.contains(target, Text.rename_words(body, [C.Pair{"u", "u"}, C.Pair{"v", "v"}, C.Pair{"w", "p"}, C.Pair{"z", "q"}], [C.Pair{"NatTrans", "Composite_NatTrans"}, C.Pair{"natApp", "Composite_natApp"}, C.Pair{"naturality", "Composite_naturality"}, C.Pair{"Base_Functor", "Base_Composite_Functor"}, C.Pair{"Base_functorObj", "Base_Composite_functorObj"}, C.Pair{"Base_functorMap", "Base_Composite_functorMap"}, C.Pair{"Base_functorMapId", "Base_Composite_functorMapId"}, C.Pair{"Base_functorMapComp", "Base_Composite_functorMapComp"}, C.Pair{"Base_eqCongr", "Base_Composite_eqCongr"}, C.Pair{"Base_Source", "Base_Source"}, C.Pair{"Base_Source_Category", "Base_Source_Category"}, C.Pair{"Base_Source_Hom", "Base_Source_Hom"}, C.Pair{"Base_Source_id", "Base_Source_id"}, C.Pair{"Base_Source_comp", "Base_Source_comp"}, C.Pair{"Base_Source_idComp", "Base_Source_idComp"}, C.Pair{"Base_Source_compId", "Base_Source_compId"}, C.Pair{"Base_Source_assoc", "Base_Source_assoc"}, C.Pair{"Base_Source_eqTrans", "Base_Source_eqTrans"}, C.Pair{"Base_Source_eqCongr", "Base_Source_eqCongr"}, C.Pair{"Base_Target", "Base_Target"}, C.Pair{"Base_Target_Category", "Base_Target_Category"}, C.Pair{"Base_Target_Hom", "Base_Target_Hom"}, C.Pair{"Base_Target_id", "Base_Target_id"}, C.Pair{"Base_Target_comp", "Base_Target_comp"}, C.Pair{"Base_Target_idComp", "Base_Target_idComp"}, C.Pair{"Base_Target_compId", "Base_Target_compId"}, C.Pair{"Base_Target_assoc", "Base_Target_assoc"}, C.Pair{"Base_Target_eqTrans", "Base_Target_eqTrans"}, C.Pair{"Base_Target_eqCongr", "Base_Target_eqCongr"}])), "natural transformation mirror changed: Composite")
    +source : String <- R.read_all(root, ["prelude/cat/category-core.mech", "prelude/cat/composable-functors.mech", "prelude/cat/heterogeneous-whiskering.mech"])
    fixture : String <- R.read_all(root, ["test/fixtures/prelude/heterogeneous-whiskering.mech", "test/fixtures/prelude/heterogeneous-whiskering-runtime.mech"])
    parsed : List<&2, S.Decl> <- R.lift(List<&2, S.Decl>, R.parse_roundtrip(source ++ fixture))
    +checked : Elab.Checked <- R.lift(Elab.Checked, R.elaborated(G.initial(), parsed))
    +globals : G.T = R.globals(checked)
    ok : Unit <- R.lift(Unit, Program.inventory(checked, expected_entries(), expected_families()))
    ok : Unit <- R.lift(Unit, Program.global_inventory(globals, expected_entries()))
    ok : Unit <- R.lift(Unit, R.computations(values(), globals))
    ok : Unit <- Neg.run(root, "test/neg/heterogeneous-whiskering", negatives(), globals, Neg.Prefix{9n, True{}, False{}})
    ok : Unit <- R.lift(Unit, R.refuse_exact(Elab.check_in(G.empty(), B.unlimited(), source ++ "specialize MechHeterogeneousWhiskering (0, 1, 2, 3, 4) as Bad\n"), "universe: the family schema MechHeterogeneousWhiskering expects 6 universe arguments, got 5\n", "universe arity"))
    ok : Unit <- R.lift(Unit, R.budget_refusal(source))
    return "entries=274 instances=4 computations=4 negatives=16"

def arguments(args: List<String>) -> IO(Unit):
  R.run("PRELUDE-HETEROGENEOUS-WHISKERING", suite(R.root(args)))

def main() -> IO(Unit):
  do IO<Unit>:
    args : List<String> <- IO.args()
    arguments(args)
