compId", "Wide_Middle1_eqCongr", "Wide_Middle1_eqTrans", "Wide_Middle1_id", "Wide_Middle1_idComp", "Wide_Middle2_Category", "Wide_Middle2_Hom", "Wide_Middle2_assoc", "Wide_Middle2_comp", "Wide_Middle2_compId", "Wide_Middle2_eqCongr", "Wide_Middle2_eqTrans", "Wide_Middle2_id", "Wide_Middle2_idComp", "Wide_Source_Category", "Wide_Source_Hom", "Wide_Source_assoc", "Wide_Source_comp", "Wide_Source_compId", "Wide_Source_eqCongr", "Wide_Source_eqTrans", "Wide_Source_id", "Wide_Source_idComp", "Wide_Target_Category", "Wide_Target_Hom", "Wide_Target_assoc", "Wide_Target_comp", "Wide_Target_compId", "Wide_Target_eqCongr", "Wide_Target_eqTrans", "Wide_Target_id", "Wide_Target_idComp", "Wide_hcompAssoc", "assocLaw", "assocLawAbstract", "assocLeftAt", "assocLhs", "assocRhs", "assocRightAt", "certified", "componentLaw", "components", "pairCode", "pathTrans", "swap"]

def expected_families() -> List<&2, String>:
  ["Middle1", "Middle2", "Mixed_Middle1", "Mixed_Middle2", "Mixed_Source", "Mixed_Target", "Path", "Point", "SeparateTarget", "Source", "Target", "Wide_Middle1", "Wide_Middle2", "Wide_Source", "Wide_Target"]

def negatives() -> List<&2, String>:
  ["false-components", "missing-middle-transformation", "missing-final-transformation", "missing-postcomposition", "nominal-target", "incompatible-endpoints", "reflexivity-control"]

def values() -> List<&2, Program.Probe>:
  [Program.Probe{"assocLeftAt", 0, 814}, Program.Probe{"assocRightAt", 0, 814}, Program.Probe{"assocLeftAt", 37, 4625}, Program.Probe{"assocRightAt", 37, 4625}, Program.Probe{"assocLeftAt", 41, 5037}, Program.Probe{"assocRightAt", 41, 5037}]

def suite(+root: String) -> R.Task(String):
  do R.Task<String>:
    +templates : String <- R.read_all(root, ["prelude/cat/category-core.mech", "prelude/cat/heterogeneous-functor.mech", "prelude/cat/composable-functors.mech", "prelude/cat/heterogeneous-nattrans.mech", "prelude/cat/heterogeneous-whiskering.mech", "prelude/cat/shared-nattrans.mech", "prelude/cat/horizontal-associativity.mech", "test/fixtures/prelude/horizontal-associativity.mech"])
    +fixture : String <- R.read_all(root, ["test/fixtures/prelude/horizontal-associativity-runtime.mech"])
    parsed : List<&2, S.Decl> <- R.lift(List<&2, S.Decl>, R.parse_roundtrip(templates ++ "\n" ++ fixture))
    +checked : Elab.Checked <- R.lift(Elab.Checked, Program.staged(templates, fixture, 8n))
    ok : Unit <- R.lift(Unit, Program.inventory(checked, expected_entries(), expected_families()))
    +globals : G.T = R.globals(checked)
    ok : Unit <- R.lift(Unit, Program.probes(values(), globals))
    ok : Unit <- Neg.run(root, "test/neg/horizontal-associativity", negatives(), globals, Neg.Digest{0n, 256, [], True{}, False{}})
    return "entries=2328 families=15 computations=6 negatives=7"

def arguments(args: List<String>) -> IO(Unit):
  R.run("PRELUDE-HORIZONTAL-ASSOCIATIVITY", suite(R.root(args)))

def main() -> IO(Unit):
  do IO<Unit>:
    args : List<String> <- IO.args()
    arguments(args)
