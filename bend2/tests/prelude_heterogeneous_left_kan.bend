def values() -> List<&2, C.Pair<String, T.T>>:
  [C.Pair{"lanUnitResult", R.natural(38)}, C.Pair{"lanMapResult", R.natural(40)}, C.Pair{"lanDescFirst", R.natural(42)}, C.Pair{"lanDescSecond", R.natural(50)}]

def suite(+root: String) -> R.Task(String):
  do R.Task<String>:
    +source : String <- R.read_all(root, ["prelude/cat/category-core.mech", "prelude/cat/composable-functors.mech", "prelude/cat/heterogeneous-whiskering.mech", "prelude/cat/heterogeneous-left-kan.mech"])
    fixture : String <- R.read_all(root, ["test/fixtures/prelude/heterogeneous-left-kan.mech", "test/fixtures/prelude/heterogeneous-left-kan-runtime.mech"])
    parsed : List<&2, S.Decl> <- R.lift(List<&2, S.Decl>, R.parse_roundtrip(source ++ fixture))
    +checked : Elab.Checked <- R.lift(Elab.Checked, R.elaborated(G.initial(), parsed))
    +globals : G.T = R.globals(checked)
    ok : Unit <- R.lift(Unit, Program.inventory(checked, expected_entries(), expected_families()))
    ok : Unit <- R.lift(Unit, Program.global_inventory(globals, expected_entries()))
    ok : Unit <- R.lift(Unit, R.computations(values(), globals))
    ok : Unit <- Neg.run(root, "test/neg/heterogeneous-left-kan", negatives(), globals, Neg.Prefix{9n, True{}, False{}})
    ok : Unit <- R.lift(Unit, R.refuse_exact(Elab.check_in(G.empty(), B.unlimited(), source ++ "specialize MechHeterogeneousLeftKan (0, 1, 2, 3, 4) as Bad\n"), "universe: the family schema MechHeterogeneousLeftKan expects 6 universe arguments, got 5\n", "universe arity"))
    ok : Unit <- R.lift(Unit, R.budget_refusal(source))
    return "entries=294 instances=3 computations=4 negatives=15"

def arguments(args: List<String>) -> IO(Unit):
  R.run("PRELUDE-HETEROGENEOUS-LEFT-KAN", suite(R.root(args)))

def main() -> IO(Unit):
  do IO<Unit>:
    args : List<String> <- IO.args()
    arguments(args)
