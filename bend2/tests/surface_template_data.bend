  [Data.ParseCase{"0", "specialize Box (0) as P with ()", ""},
   Data.ParseCase{"1", "specialize Box (0) as P with ( )", ""},
   Data.ParseCase{"2", "specialize Box (0) as P with (Box Existing)", ""},
   Data.ParseCase{"3", "specialize Box (0) as P with (Box := Existing,)", ""},
   Data.ParseCase{"4", "specialize Box (0) as P with (Box := Existing", ""},
   Data.ParseCase{"5", "poly (u) group P where specialize Box (u) as B with (Box := Existing,) end", ""}]

