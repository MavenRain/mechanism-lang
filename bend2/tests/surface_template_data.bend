def template_composition_client() -> String:
  "mu Tiny : Type with | zero : Tiny specialize Pair (0, 1) as P specialize Nested (0) as N specialize Maximum (0, 2) as M specialize Impredicative (2, 0) as I def low : P_Left Tiny := box zero def high : P_Right Type := P_transfer Tiny Type (fun (x : Tiny) => Tiny) low def result : Type := P_Right_unbox Type high def nested : Type := N_project Type (box Tiny) "

