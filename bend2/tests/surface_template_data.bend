   Data.Negative{"duplicate-member", "rendered", "mismatch: the name member is already declared", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group Group where specialize Box (u) as Local def member : Local := box def member : Local := box end "},
   Data.Negative{"imported-label-member", "rendered", "mismatch: the name box is already declared", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group Group where specialize Box (u) as Local def box : Local := box end "},
   Data.Negative{"imported-label-prefix", "rendered", "mismatch: the name box is already declared", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group Group where specialize Box (u) as box end "},
   Data.Negative{"body-unbound", "rendered", "unbound: missing", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group Group where specialize Box (u) as Local def member : Local := missing end "},
   Data.Negative{"member-forward", "rendered", "unbound: later", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group Group where specialize Box (u) as Local def member : Local := later def later : Local := box end "},
   Data.Negative{"bare-import", "rendered", "unbound: Local", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group Group where specialize Box (u) as Local  end def bad : Type := Local"},
   Data.Negative{"bare-group", "rendered", "unbound: Group", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group Group where specialize Box (u) as Local  end def bad : Type := Group"},
   Data.Negative{"global-group-collision", "rendered", "mismatch: the name Group is already declared", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box def Group : Type := Prop poly (u) group Group where specialize Box (u) as Local  end "},
   Data.Negative{"definition-template-dependency", "rendered", "unbound: unknown family universe schema Identity", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) def Identity : Sort (succ u) := Sort u poly (u) group Group where specialize Identity (u) as Local end "},
   Data.Negative{"prefix-definition-template", "rendered", "mismatch: the name Local is already declared", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) def Local : Sort (succ u) := Sort u poly (u) group Group where specialize Box (u) as Local  end "},
   Data.Negative{"label-late-template", "rendered", "mismatch: the name box is already declared", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group Group where specialize Box (u) as Local  end poly (u) def box : Sort (succ u) := Sort u specialize Group (0) as G"},
   Data.Negative{"output-family-collision", "rendered", "mismatch: the name G_Local is already declared", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group Group where specialize Box (u) as Local  end mu G_Local : Type with specialize Group (0) as G"},
   Data.Negative{"output-template-collision", "rendered", "mismatch: the name G_Local is already declared", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group Group where specialize Box (u) as Local  end poly (u) def G_Local : Sort (succ u) := Sort u specialize Group (0) as G"},
   Data.Negative{"nominal-imports", "rendered", "mismatch: the term has type (Lan SMu Second_Local [] (Sec SColl 0 [])) and the expected type is (Lan SMu First_Local [] (Sec SColl 0 []))", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group Group where specialize Box (u) as Local def witness : Local := box end specialize Group (0) as First specialize Group (0) as Second def mixed : First_Local := Second_witness"},
   Data.Negative{"duplicate-disjoint-prefix", "rendered", "mismatch: the name Shared is already declared", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group A where specialize Box (u) as One end poly (u) group B where specialize Box (u) as Two end poly (u) group Group where specialize A (u) as Shared specialize B (u) as Shared end "},
   Data.Negative{"prefix-generated-family", "rendered", "mismatch: the name X_One is already declared", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group A where specialize Box (u) as One end poly (u) group B where specialize Box (u) as Two end poly (u) group Group where specialize A (u) as X specialize B (u) as X_One end "},
   Data.Negative{"prefix-generated-member", "rendered", "mismatch: the name X_item is already declared", None{}, "poly (u) mu Box : Sort (succ u) with | box : Box poly (u) group A where specialize Box (u) as One def item : One := box end poly (u) group B where specialize Box (u) as Two end poly (u) group Group where specialize A (u) as X specialize B (u) as X_item end "}]

def template_composition_parsers() -> List<&2, Data.ParseCase>:
  [Data.ParseCase{"empty", "poly (u) group Group where  end ", "expected at least one template specialization in a group, found 'end'"},
   Data.ParseCase{"no-dependencies", "poly (u) group Group where def item : Type := Prop end ", "expected at least one template specialization in a group, found 'def'"},
   Data.ParseCase{"missing-name", "poly (u) group where end", "expected 'group NAME where' after universe binders, found 'group'"},
   Data.ParseCase{"open-level", "poly (u) group Group where specialize Box (v) as Local end ", "unbound universe v"},
   Data.ParseCase{"scope-leak", "poly (u) group Group where specialize Box (u) as Local  end specialize Group (u) as Closed", "unbound universe u"},
   Data.ParseCase{"postulate", "poly (u) group Group where specialize Box (u) as Local axiom item : Local end ", "expected 'def' or 'end' in family members, found 'axiom'"},
   Data.ParseCase{"recursive", "poly (u) group Group where specialize Box (u) as Local def rec item : Local := box end ", "expected a nonrecursive member definition, found 'def'"},
   Data.ParseCase{"late-dependency", "poly (u) group Group where specialize Box (u) as Local def item : Local := box specialize Box (u) as Local  end ", "expected 'def' or 'end' in family members, found 'specialize'"},
   Data.ParseCase{"missing-end", "poly (u) group Group where specialize Box (u) as Local ", "expected 'def' or 'end' in family members, found end of input"}]
