def right_statement() -> String:
  "(0 C : Sort (succ u0)) -> (0 D : Sort (succ u2)) -> (c : Source_Category C) -> (d : Target_Category D) -> (F : Before_Second_Base_Functor C D c d) -> (G : Before_Second_Base_Functor C D c d) -> (alpha : Before_Second_NatTrans C D c d F G) -> (x : C) -> Target (Target_Hom D d (F.1 x) (G.1 x)) ((Before_Compose_whiskerRight C C D c c d F G alpha (SourceIdentity_idFunctor C c)).1 x) (alpha.1 x)"

def left_statement() -> String:
  "(0 C : Sort (succ u0)) -> (0 D : Sort (succ u2)) -> (c : Source_Category C) -> (d : Target_Category D) -> (F : After_First_Base_Functor C D c d) -> (G : After_First_Base_Functor C D c d) -> (alpha : After_First_NatTrans C D c d F G) -> (x : C) -> Target (Target_Hom D d (F.1 x) (G.1 x)) ((After_Compose_whiskerLeft C D D c d d (TargetIdentity_idFunctor D d) F G alpha).1 x) (alpha.1 x)"

def values() -> List<&2, Program.Probe>:
  [Program.Probe{"preUnitAt", 0, 707}, Program.Probe{"postUnitAt", 0, 707}, Program.Probe{"leftUnitAt", 0, 707}, Program.Probe{"rightUnitAt", 0, 707}, Program.Probe{"unitReferenceAt", 0, 707}, Program.Probe{"preUnitAt", 37, 8218}, Program.Probe{"postUnitAt", 37, 8218}, Program.Probe{"leftUnitAt", 37, 8218}, Program.Probe{"rightUnitAt", 37, 8218}, Program.Probe{"unitReferenceAt", 37, 8218}, Program.Probe{"preUnitAt", 41, 9030}, Program.Probe{"postUnitAt", 41, 9030}, Program.Probe{"leftUnitAt", 41, 9030}, Program.Probe{"rightUnitAt", 41, 9030}, Program.Probe{"unitReferenceAt", 41, 9030}]

def suite(+root: String) -> R.Task(String):
  do R.Task<String>:
    source : String <- R.read_all(root, ["prelude/cat/category-core.mech", "prelude/cat/heterogeneous-functor.mech", "prelude/cat/composable-functors.mech", "prelude/cat/heterogeneous-nattrans.mech", "prelude/cat/heterogeneous-whiskering.mech", "prelude/cat/shared-nattrans.mech", "prelude/cat/identity-functor.mech", "prelude/cat/nattrans-units.mech", "test/fixtures/prelude/nattrans-units.mech"])
    fixture : String <- R.read_all(root, ["test/fixtures/prelude/heterogeneous-nattrans-runtime.mech", "test/fixtures/prelude/nattrans-units-runtime.mech"])
    +parsed : List<&2, S.Decl> <- R.lift(List<&2, S.Decl>, R.parse_roundtrip(source ++ "\n" ++ fixture))
    +bodies : List<&2, C.Pair<String, String>> = definitions(parsed)
    ok : Unit <- R.lift(Unit, head_pins([C.Pair{"PreUnit", "Units_Before_Compose_whiskerRight"}, C.Pair{"PostUnit", "Units_After_Compose_whiskerLeft"}, C.Pair{"LeftUnit", "Units_Before_hcomp"}, C.Pair{"RightUnit", "Units_After_hcomp"}], bodies))
    ok : Unit <- R.lift(Unit, case_pins([C.Pair{"pre", "PreUnit"}, C.Pair{"post", "PostUnit"}, C.Pair{"left", "LeftUnit"}, C.Pair{"right", "RightUnit"}], bodies))
    +types : List<&2, C.Pair<String, S.T>> = templates(parsed)
    ok : Unit <- R.lift(Unit, law_statement(types, "whiskerRightIdFunctor", right_statement()))
    ok : Unit <- R.lift(Unit, law_statement(types, "whiskerLeftIdFunctor", left_statement()))
    +checked : Elab.Checked <- R.lift(Elab.Checked, R.elaborated(G.initial(), parsed))
    ok : Unit <- R.lift(Unit, Program.inventory(checked, expected_entries(), expected_families()))
    +globals : G.T = R.globals(checked)
    ok : Unit <- R.lift(Unit, Program.probes(values(), globals))
    ok : Unit <- Neg.run(root, "test/neg/nattrans-units", negatives(), globals, Neg.Digest{0n, 256, ["left-reflexivity", "right-reflexivity"], True{}, True{}})
    return "entries=1281 families=9 computations=15 negatives=6"

def arguments(args: List<String>) -> IO(Unit):
  R.run("PRELUDE-NATTRANS-UNITS", suite(R.root(args)))

def main() -> IO(Unit):
  do IO<Unit>:
    args : List<String> <- IO.args()
    arguments(args)
