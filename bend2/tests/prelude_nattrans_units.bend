import Base
import ./relational_common.bend as R
import ./relational_negatives.bend as Neg
import ./relational_program.bend as Program
import ./relational_text.bend as Text
import ../kernel/common.bend as C
import ../kernel/global.bend as G
import ../surface/syntax.bend as S
import ../surface/elab.bend as Elab
import ../kernel/bignum.bend as Big

# Keep the original law assertions on the public precedence printer.
def law_at(level: Nat, term: S.T) -> Result<&2, &2, String, String>:
  Done{S.at(Big.of_nat(level), term)}

def law_lookup(types: List<&2, C.Pair<String, S.T>>, +name: String) -> Maybe<&2, S.T>:
  match types:
    case Nil{}: None{}
    case Con{C.Pair{found, ty}, rest}: Bool.pick(Maybe<&2, S.T>, String.eq(found, name), Some{ty}, law_lookup(rest, name))

def law_found(found: Maybe<&2, S.T>, name: String, expected: String) -> Result<&2, &2, String, Unit>:
  match found:
    case None{}: Fail{"missing whisker law: " ++ name}
    case Some{ty}: do Result<&2, &2, String, Unit>:
      actual : String <- law_at(0n, ty)
      R.require(String.eq(Text.normalise(actual), expected), "whisker law restated: " ++ name)

def law_statement(types: List<&2, C.Pair<String, S.T>>, +name: String, expected: String) -> Result<&2, &2, String, Unit>:
  law_found(law_lookup(types, name), name, expected)

def definition(declaration: S.Decl) -> List<&2, C.Pair<String, String>>:
  match declaration:
    case S.DDef{name, ty, body}: [C.Pair{name, S.show(body)}]
    case _: []

def definitions(declarations: List<&2, S.Decl>) -> List<&2, C.Pair<String, String>>:
  match declarations:
    case Nil{}: []
    case Con{head, rest}: List.append(&2, C.Pair<String, String>, definition(head), definitions(rest))

def helper_types(helpers: List<&2, S.RecDef<S.T>>) -> List<&2, C.Pair<String, S.T>>:
  match helpers:
    case Nil{}: []
    case Con{S.RecDef{name, ty, body}, rest}: C.Pair{name, ty} <> helper_types(rest)

def selected_types(name: String, helpers: List<&2, S.RecDef<S.T>>) -> List<&2, C.Pair<String, S.T>>:
  Bool.pick(List<&2, C.Pair<String, S.T>>, String.eq(name, "MechNatTransUnits"), helper_types(helpers), [])

def template(declaration: S.Decl) -> List<&2, C.Pair<String, S.T>>:
  match declaration:
    case S.DPolyCompose{arity, name, specializations, helpers}: selected_types(name, helpers)
    case S.DPolyGroup{arity, S.Fam{name, params, ty, ctors}, families, helpers}: selected_types(name, helpers)
    case _: []

def templates(declarations: List<&2, S.Decl>) -> List<&2, C.Pair<String, S.T>>:
  match declarations:
    case Nil{}: []
    case Con{head, rest}: List.append(&2, C.Pair<String, S.T>, template(head), templates(rest))

def first_is(tokens: List<&2, String>, expected: String) -> Bool:
  match tokens:
    case Nil{}: False{}
    case Con{head, rest}: String.eq(head, expected)

def head_pins(pins: List<&2, C.Pair<String, String>>, +bodies: List<&2, C.Pair<String, String>>) -> Result<&2, &2, String, Unit>:
  match pins:
    case Nil{}: Done{Unit{}}
    case Con{C.Pair{+name, expected}, rest}: do Result<&2, &2, String, Unit>:
      ok : Unit <- R.require(first_is(Text.identifiers(Text.lookup(bodies, name)), expected), "unit head changed: " ++ name)
      head_pins(rest, bodies)

def case_pins(pins: List<&2, C.Pair<String, String>>, +bodies: List<&2, C.Pair<String, String>>) -> Result<&2, &2, String, Unit>:
  match pins:
    case Nil{}: Done{Unit{}}
    case Con{C.Pair{+name, expected}, rest}: do Result<&2, &2, String, Unit>:
      +identifiers : List<&2, String> = Text.identifiers(Text.lookup(bodies, name ++ "UnitAt"))
      ok : Unit <- R.require(Bool.and(R.contains(identifiers, expected), R.contains(identifiers, name ++ "UnitLaw")), "case rebound: " ++ name ++ "UnitAt")
      case_pins(rest, bodies)

