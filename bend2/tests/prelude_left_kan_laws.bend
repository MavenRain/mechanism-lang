def required_rows(names: List<&2,String>, +rows: List<&2,String>) -> Result<&2,&2,String,Unit>:
  match names:
    case Nil{}: Done{Unit{}}
    case Con{+name,rest}: do Result<&2,&2,String,Unit>:
      ok : Unit <- R.require(R.contains(rows,name), "missing checked law or symbolic pin: " ++ name)
      required_rows(rest,rows)

def suite(+root: String) -> R.Task(String):
  do R.Task<String>:
    +templates : String <- R.read_all(root, ["prelude/cat/category-core.mech", "prelude/cat/heterogeneous-functor.mech", "prelude/cat/composable-functors.mech", "prelude/cat/heterogeneous-nattrans.mech", "prelude/cat/heterogeneous-whiskering.mech", "prelude/cat/shared-nattrans.mech", "prelude/cat/heterogeneous-left-kan.mech", "prelude/cat/shared-left-kan.mech", "prelude/cat/left-kan-laws.mech", "test/fixtures/prelude/left-kan-laws.mech", "test/fixtures/prelude/shared-left-kan-runtime.mech", "test/fixtures/prelude/left-kan-laws-runtime.mech"])
    +fixture : String <- R.read_all(root, [])
    parsed : List<&2, S.Decl> <- R.lift(List<&2, S.Decl>, R.parse_roundtrip(templates ++ "\n" ++ fixture))
    +checked : Elab.Checked <- R.lift(Elab.Checked, R.elaborated(G.initial(), parsed))
    ok : Unit <- R.lift(Unit, Program.inventory(checked, expected_entries(), expected_families()))
    +globals : G.T = R.globals(checked)
    ok : Unit <- R.lift(Unit, required_rows(["Laws_postCoconeCongr", "Wide_postCoconeCongr", "WidePostCoconeCongrContract", "postCongrLaw", "postReverseCongrLaw", "Laws_CoconeEq", "Laws_descId", "Laws_descCongr", "Laws_postCocone", "Laws_descPostcomp", "Wide_CoconeEq", "Wide_descId", "Wide_descCongr", "Wide_postCocone", "Wide_descPostcomp", "WideIdContract", "WideCongrContract", "WidePostcompContract", "Laws_postCoconeId", "Laws_postCoconeVcomp", "Wide_postCoconeId", "Wide_postCoconeVcomp", "WidePostCoconeIdContract", "WidePostCoconeVcompContract"], R.entry_names(R.rows(checked))))
    ok : Unit <- R.lift(Unit, R.computations(values(), globals))
    ok : Unit <- Neg.run(root, "test/neg/left-kan-laws", negatives(), globals, Neg.Prefix{64n, True{}, False{}})
    return "entries=1002 families=9 computations=20 negatives=18"

def arguments(args: List<String>) -> IO(Unit):
  R.run("PRELUDE-LEFT-KAN-LAWS", suite(R.root(args)))

def main() -> IO(Unit):
  do IO<Unit>:
    args : List<String> <- IO.args()
    arguments(args)
